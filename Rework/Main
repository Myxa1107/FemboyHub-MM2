local function getFPS()
	local frameTime = Stats.FrameRateManager.RenderAverage:GetValue()
	if frameTime > 0 then
		return math.floor(1000 / frameTime)
	end
	return 0
end

local function getPing()
	-- Получаем значение Data Ping в миллисекундах
	local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	return math.floor(ping) -- Округляем до целого числа
end

