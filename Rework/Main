local cR
local cS={}
local cT=false

local function FormatPlayerText(cU)
local cV=GetRole(cU)
local cW=GetColor(cV)
local cX="#FFFFFF"

if typeof(cW)=="Color3"then
cX="#"..cW:ToHex()
elseif type(cW)=="string"then

cX=cW:sub(1,1)=="#"and cW or("#"..cW)
end

return string.format('%s [<font color="%s">%s</font>]',cU.DisplayName,cX,tostring(cV))
end


local function EnableRichText(cU)
if cU.TextLabel then
cU.TextLabel.RichText=true
elseif cU.Label then
cU.Label.RichText=true
elseif cU.Holder then
local cV=cU.Holder:FindFirstChildWhichIsA("TextLabel",true)
if cV then
cV.RichText=true
end
end
end


function UpdatePlayerCheckboxes()
for cU,cV in pairs(cS)do
if cU and cU.Parent==j and cV then
EnableRichText(cV)
local cW=FormatPlayerText(cU)

if cV.SetText then
cV:SetText(cW)
elseif cV.TextLabel then
cV.TextLabel.Text=cW
end
end
end
end


local function UpdateTabboxSize()
task.wait()
if cP.Resize then cP:Resize()end
if b1.Resize then b1:Resize()end
end


local function SelectFirstAvailablePlayer()
for cU,cV in pairs(cS)do
if cU and cU.Parent==j then
cR=cU
cT=true
cV:SetValue(true)
cT=false
return
end
end
cR=nil
end


local function AddPlayerCheckbox(cU)
if cU==k or cS[cU]then return end

local cV="TrollTarget_"..cU.Name

local cW=cP:AddCheckbox(cV,{
Text=FormatPlayerText(cU),
Default=false,
Callback=function(cW)
if cT then return end

if cW then
cR=cU
cT=true
for cX,cY in pairs(cS)do
if cX~=cU and cY.Value then
cY:SetValue(false)
end
end
cT=false
else
if cR==cU and cU.Parent==j then
task.spawn(function()
task.wait()
local cX=cS[cU]
if cR==cU and cX and not cX.Value then
cT=true
cX:SetValue(true)
cT=false
end
end)
end
end
end,
})


EnableRichText(cW)
cS[cU]=cW

if not cR then
cR=cU
cT=true
cW:SetValue(true)
cT=false
end

UpdateTabboxSize()
end


local function RemovePlayerCheckbox(cU)
local cV=cS[cU]
if not cV then return end

local cW=(cR==cU)
if cW then
cR=nil
end

if cV.Holder then
cV.Holder:Destroy()
elseif cV.Container then
cV.Container:Destroy()
else
cV:SetVisible(false)
end

local cX="TrollTarget_"..cU.Name
if b.Toggles then b.Toggles[cX]=nil end
if b.Options then b.Options[cX]=nil end

cS[cU]=nil

if cW then
SelectFirstAvailablePlayer()
end

UpdateTabboxSize()
end


for cU,cV in ipairs(j:GetPlayers())do
AddPlayerCheckbox(cV)
end

if not cR then
SelectFirstAvailablePlayer()
end

j.PlayerAdded:Connect(AddPlayerCheckbox)
j.PlayerRemoving:Connect(RemovePlayerCheckbox)

local cU=bq.Troll:AddGroupbox{
Side="Right",
Name="Target",
DisableCollapsing=true,
}


local cV=cU:AddImage("TargetAvatar",{
Image="rbxassetid://0",
Height=100,
})

local cW=cU:AddLabel"Display Name: None"
local cX=cU:AddLabel"Username: None"
local cY=cU:AddLabel"User ID: None"
local cZ=cU:AddLabel"Role: None"



if cZ.TextLabel then
cZ.TextLabel.RichText=true
elseif cZ.Label then
cZ.Label.RichText=true
elseif cZ.Holder then
local c_=cZ.Holder:FindFirstChildWhichIsA("TextLabel",true)
if c_ then c_.RichText=true end
end

local function UpdateTargetInfo(c_)
if c_ and c_.Parent==j then
cW:SetText("Display Name: "..c_.DisplayName)
cX:SetText("Username: @"..c_.Name)
cY:SetText("User ID: "..tostring(c_.UserId))


local c0=GetRole(c_)
local c1=GetColor(c0)
local c2="#FFFFFF"

if typeof(c1)=="Color3"then
c2="#"..c1:ToHex()
elseif type(c1)=="string"then
c2=c1:sub(1,1)=="#"and c1 or("#"..c1)
end

cZ:SetText(string.format('Role: <font color="%s">%s</font>',c2,tostring(c0)))


task.spawn(function()
local c3,c4=pcall(function()
return j:GetUserThumbnailAsync(
c_.UserId,
Enum.ThumbnailType.HeadShot,
Enum.ThumbnailSize.Size150x150
)
end)


if c3 and c4 and cR==c_ then
if cV.SetImage then
cV:SetImage(c4)
elseif cV.ImageLabel then
cV.ImageLabel.Image=c4
end
end
end)
else
cW:SetText"Display Name: -"
cX:SetText"Username: -"
cY:SetText"User ID: -"
cZ:SetText"Role: -"

if cV.SetImage then
cV:SetImage"rbxassetid://0"
elseif cV.ImageLabel then
cV.ImageLabel.Image="rbxassetid://0"
end
end
end


function RefreshTargetInfo()
UpdateTargetInfo(cR)
end


local c_=false

o.Heartbeat:Connect(function()
if cR~=c_ then
c_=cR
UpdateTargetInfo(cR)
end
end)

