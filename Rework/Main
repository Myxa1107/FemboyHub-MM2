local ci={}
local cj={}

local function setupEffect(ck,cl)
local cm=cl:FindFirstChildOfClass(ck)
if cm then
local cn={}
if ck~="Sky"and ck~="Atmosphere"and ck~="Clouds"then
cn.Enabled=cm.Enabled
if ck=="BlurEffect"then
cn.Size=cm.Size
elseif ck=="DepthOfFieldEffect"then
cn.FarIntensity=cm.FarIntensity
cn.NearIntensity=cm.NearIntensity
cn.FocusDistance=cm.FocusDistance
cn.InFocusRadius=cm.InFocusRadius
end
end
table.insert(ci,{instance=cm,props=cn})

local co=cm:Clone()
co.Parent=cl
if ck~="Sky"and ck~="Atmosphere"and ck~="Clouds"then
co.Enabled=false
end
table.insert(cj,co)
return co
else
local cn=Instance.new(ck,cl)
if ck~="Sky"and ck~="Atmosphere"and ck~="Clouds"then
cn.Enabled=false
end
table.insert(cj,cn)
return cn
end
end

local ck=setupEffect("BloomEffect",b5)
local cl=setupEffect("Sky",b5)
local cm=setupEffect("Atmosphere",b5)
local cn=setupEffect("BlurEffect",b5)
local co=setupEffect("DepthOfFieldEffect",b5)
local cp=setupEffect("ColorCorrectionEffect",b5)
local cq=setupEffect("SunRaysEffect",b5)
local cr=setupEffect("Clouds",b6)


local cs={
