local TELEPORT_DISTANCE = 80    -- если дальше - телепорт к игроку
local REPATH_DISTANCE = 6       -- если игрок сдвинулся на столько - путь строится заново

-- Виден ли человечек (true - виден, false - скрыт, но продолжает ходить).
