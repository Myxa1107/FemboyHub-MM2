local function getBundleDescription(bd)
if bc[bd]~=nil then
return bc[bd]or nil
end

local be=false

local bf,bg=pcall(function()
return aN:GetBundleDetailsAsync(bd)
end)

if bf and bg and bg.Items then
for bh,bi in ipairs(bg.Items)do
if bi.Type=="UserOutfit"then
local bj,bk=pcall(function()
return j:GetHumanoidDescriptionFromOutfitId(bi.Id)
end)
if bj and bk then
be=bk
break
end
end
end

end

bc[bd]=be
return be or nil
end

local bd={"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"}


local be

local function resolveAnimations()
if be then
return be
end

local bf={}
for bg,bh in pairs(a9)do
bf[bg]=bh
end

if a8>0 then
local bg=getBundleDescription(a8)
if bg then
for bh in pairs(a9)do

local bi,bj=pcall(function()
return bg[bh.."Animation"]
end)
if bi and type(bj)=="number"and bj>0 then
bf[bh]=bj
end
end
end
end

be=bf
return bf
end




local function buildDescription()
local bf=Instance.new"HumanoidDescription"

bf.Shirt=aV
bf.Pants=aW
bf.GraphicTShirt=aX
bf.Face=aY

if aZ then
bf.HeadColor=aZ
bf.TorsoColor=aZ
bf.LeftArmColor=aZ
bf.RightArmColor=aZ
bf.LeftLegColor=aZ
bf.RightLegColor=aZ
end


local bg=false
if a0>0 then
local bh=getBundleDescription(a0)
if bh then
bg=true
for bi,bj in ipairs(bd)do
bf[bj]=bh[bj]
end
if a1 then
bf.Head=0
elseif a2>0 then
bf.Head=a2
end


if aY==0 and not a1 and bh.Face>0 then
bf.Face=bh.Face
end
end
end

if not bg then
if a2>0 then bf.Head=a2 end
if a3>0 then bf.Torso=a3 end
if a4>0 then bf.LeftArm=a4 end
if a5>0 then bf.RightArm=a5 end
if a6>0 then bf.LeftLeg=a6 end
if a7>0 then bf.RightLeg=a7 end
end


if#a_>0 then
local bh={}
for bi,bj in ipairs(a_)do
table.insert(bh,tostring(bj))
end
bf.HatAccessory=table.concat(bh,",")
end

return bf
end






local function finishTrack(bf,bg,bh,bi)
local bj,bk=pcall(function()
return bf:LoadAnimation(bg)
end)
if not bj or not bk then
return nil
end

local bl=0
while bk.Length==0 and bl<bb do
bl+=task.wait(0.1)
end
if bk.Length==0 then
bk:Destroy()
return nil
end

bk.Looped=bh
bk.Priority=bi
return bk
end


local function loadTrackDirect(bf,bg,bh,bi)
local bj=Instance.new"Animation"
bj.AnimationId="rbxassetid://"..tostring(bg)
return finishTrack(bf,bj,bh,bi)
end


local function loadTrackViaClip(bf,bg,bh,bi)
local bj,bk=pcall(function()
return aP:GetAnimationClipAsync("rbxassetid://"..tostring(bg))
end)
if not bj or not bk then
return nil
end

local bl,bm=pcall(function()
return aP:RegisterAnimationClip(bk)
end)
if not bl or not bm then
return nil
end

local bn=Instance.new"Animation"
bn.AnimationId=bm
return finishTrack(bf,bn,bh,bi)
end

local function loadTrack(bf,bg,bh,bi)
if not bg or bg==0 then
return nil
end

local bj=loadTrackDirect(bf,bg,bh,bi)
if bj then
return bj
end

bj=loadTrackViaClip(bf,bg,bh,bi)
if bj then
return bj
end

return nil
end




local bf
local bg={}
local bh=0

local function applyVisibility()
if not bf then
return
end
local bi=aU and 0 or 1
for bj,bk in ipairs(bf:GetDescendants())do
if bk:IsA"BasePart"or bk:IsA"Decal"then
bk.LocalTransparencyModifier=bi
end
end
end


local function setFollowerVisible(bi)
aU=bi and true or false
applyVisibility()
end

local function cleanup()
bh+=1
for bi,bj in ipairs(bg)do
bj:Disconnect()
end
table.clear(bg)
if bf then
bf:Destroy()
end
bf=nil
end

local function spawnFollower(bi)
cleanup()
local bj=bh

local bk=bi:WaitForChild"HumanoidRootPart"
local bl=bi:WaitForChild"Humanoid"

local bm=resolveAnimations()

local bn=j:CreateHumanoidModelFromDescription(buildDescription(),Enum.HumanoidRigType.R15)
bn.Name="Follower_"..l.Name

local bo=bn:WaitForChild"Humanoid"
local bp=bn:WaitForChild"HumanoidRootPart"
bo.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None


if bh~=bj then
bn:Destroy()
return
end

bn:PivotTo(bk.CFrame*CFrame.new(3,0,3))
bn.Parent=workspace
bf=bn


local bq=bi:GetScale()*aQ
bn:ScaleTo(bq)


applyVisibility()
table.insert(bg,bn.DescendantAdded:Connect(function(br)
if br:IsA"BasePart"or br:IsA"Decal"then
br.LocalTransparencyModifier=aU and 0 or 1
end
end))



local function noCollide(br,bs)
local bt=Instance.new"NoCollisionConstraint"
bt.Part0=br
bt.Part1=bs
bt.Parent=br
end

for br,bs in ipairs(bn:GetDescendants())do
if bs:IsA"BasePart"then
for bt,bu in ipairs(bi:GetDescendants())do
if bu:IsA"BasePart"then
noCollide(bs,bu)
end
end
end
end


table.insert(bg,bi.DescendantAdded:Connect(function(br)
if br:IsA"BasePart"then
for bs,bt in ipairs(bn:GetDescendants())do
if bt:IsA"BasePart"then
noCollide(bt,br)
end
end
end
end))

table.insert(bg,bn.DescendantAdded:Connect(function(br)
if br:IsA"BasePart"then
for bs,bt in ipairs(bi:GetDescendants())do
if bt:IsA"BasePart"then
noCollide(br,bt)
end
end
end
end))




local br=bo:FindFirstChildOfClass"Animator"
if not br then
br=Instance.new"Animator"
br.Parent=bo
end

local bs,bt,bu,bv,bw,bx,by,bz
local bA

local function play(bB)
if bA==bB then
return
end
if bA then
bA:Stop(0.15)
end
bA=bB
if bB then
bB:Play(0.15)
end
end

local function updateLocomotion(bB)
local bC=bo:GetState()
if bC==Enum.HumanoidStateType.Freefall
or bC==Enum.HumanoidStateType.Climbing
or bC==Enum.HumanoidStateType.Swimming then
return
end
if bB>0.5 then
if bB>18 and bu then
play(bu)
else
play(bt or bu)
end
else
play(bs)
end
end


local bB=Enum.AnimationPriority
local bC={
{"Idle",true,bB.Idle,function(bC)bs=bC end},
{"Walk",true,bB.Core,function(bC)bt=bC end},
{"Run",true,bB.Core,function(bC)bu=bC end},
{"Jump",false,bB.Action,function(bC)bv=bC end},
{"Fall",true,bB.Action,function(bC)bw=bC end},
{"Climb",true,bB.Action,function(bC)bx=bC end},
{"Swim",true,bB.Action,function(bC)by=bC end},
{"SwimIdle",true,bB.Action,function(bC)bz=bC end},
}

for bD,bE in ipairs(bC)do
task.spawn(function()
local bF,bG,bH,bI=bE[1],bE[2],bE[3],bE[4]

local bJ=loadTrack(br,bm[bF],bG,bH)
if not bJ then
if bm[bF]and bm[bF]>0 then
end
bJ=loadTrack(br,ba[bF],bG,bH)
end

if bh~=bj then
return
end

bI(bJ)

local bK=bp.AssemblyLinearVelocity
updateLocomotion(Vector3.new(bK.X,0,bK.Z).Magnitude)
end)
end

table.insert(bg,bo.Running:Connect(updateLocomotion))

table.insert(bg,bo.Climbing:Connect(function(bD)
if bx then
play(bx)
bx:AdjustSpeed(bD/5)
end
end))

table.insert(bg,bo.Swimming:Connect(function(bD)
if bD>1 and by then
play(by)
else
play(bz or by)
end
end))

local bD=Enum.HumanoidStateType
local bE=0

local function currentSpeed()
local bF=bp.AssemblyLinearVelocity
return Vector3.new(bF.X,0,bF.Z).Magnitude
end

table.insert(bg,bo.StateChanged:Connect(function(bF,bG)
if bG==bD.Jumping then
bE=os.clock()
play(bv or bw)
elseif bG==bD.Freefall then

local bH=0
if bv and bA==bv then
bH=math.max(0,0.3-(os.clock()-bE))
end
if bH>0 then
task.delay(bH,function()
if bh==bj and bo:GetState()==bD.Freefall then
play(bw)
end
end)
else
play(bw)
end
elseif bG==bD.Climbing then
play(bx)
elseif bG==bD.Swimming then
play(bz or by)
elseif bG==bD.Landed or bG==bD.Running or bG==bD.RunningNoPhysics then

updateLocomotion(currentSpeed())
end
end))




task.spawn(function()
local function alive()
return bh==bj and bn.Parent~=nil
end

local bF={
AgentRadius=2*bq,
AgentHeight=5*bq,
AgentCanJump=true,
AgentCanClimb=true,
WaypointSpacing=math.max(2,4*bq),
Costs={Water=20},
}

local bG
local bH=pcall(function()
bG=aO:CreatePath(bF)
end)
if not bH or not bG then
bF.AgentCanClimb=nil
bG=aO:CreatePath(bF)
end

local function isSwimming()
return bo:GetState()==Enum.HumanoidStateType.Swimming
end


local bI=RaycastParams.new()
bI.FilterType=Enum.RaycastFilterType.Exclude
bI.FilterDescendantsInstances={bn,bi}
bI.RespectCanCollide=true


local function castAhead(bJ,bK)
local bL=workspace:Raycast(bJ,bK,bI)
if bL then
local bM=bL.Instance:FindFirstAncestorOfClass"Model"
if not(bM and bM:FindFirstChildOfClass"Humanoid")then
return bL
end
end
return nil
end

local function maxJumpHeight()
if bo.UseJumpPower then
return bo.JumpPower^2/(2*workspace.Gravity)
end
return bo.JumpHeight
end


local function analyzeObstacle(bJ)
local bK=bp.Position
local bL=Vector3.new(bJ.X-bK.X,0,bJ.Z-bK.Z)
if bL.Magnitude<0.1 then
return false,false,0
end
local bM=bL.Unit*(3.5*bq)


local bN
for bO,bP in ipairs{0,-2.2*bq}do
local bQ=castAhead(bK+Vector3.new(0,bP,0),bM)
if bQ and(not bN or bQ.Distance<bN.Distance)then
bN=bQ
end
end
if not bN then
return false,false,0
end



local bO=bK.Y-(bo.HipHeight+bp.Size.Y/2)
local bP=bO+maxJumpHeight()*0.85
local bQ=castAhead(Vector3.new(bK.X,bP,bK.Z),bM)

return true,bQ==nil,bN.Distance
end

local bJ=0
local bK=0

local bL=3

local function inAir()
local bM=bo:GetState()
return bM==Enum.HumanoidStateType.Freefall or bM==Enum.HumanoidStateType.Jumping
end


local function doJump()
if not inAir()and not isSwimming()then
bo:ChangeState(Enum.HumanoidStateType.Jumping)
end
end


local function waitForLanding()
local bM=0
while alive()and inAir()and bM<3 do
task.wait(0.05)
bM+=0.05
end
end


local function walkWaypoints(bM,bN)
for bO=2,#bM do
if not alive()then
return
end

local bP=bM[bO]
local bQ=bP.Action==Enum.PathWaypointAction.Jump
bo:MoveTo(bP.Position)

local bR=false
local bS=bo.MoveToFinished:Connect(function()
bR=true
end)

local bT=0
local bU=false
while alive()and not bR and bT<2 do
task.wait(0.05)
bT+=0.05


if bQ and not bU then
local bV=bp.Position-bP.Position
if Vector3.new(bV.X,0,bV.Z).Magnitude<bL*bq then
bU=true
doJump()
end
end


if(bk.Position-bN).Magnitude>aT and not inAir()then
break
end
if isSwimming()then
break
end
end
bS:Disconnect()


if bQ and not bU then
bU=true
doJump()
end


if bU then
local bV=bM[bO+1]
if bV then
bo:MoveTo(bV.Position)
end
task.wait(0.05)
waitForLanding()
end

if not alive()then
return
end
if(bk.Position-bN).Magnitude>aT then
return
end
if isSwimming()or(not bR and not bU)then
return
end
end
end

while alive()do

bo.WalkSpeed=bl.WalkSpeed
bo.UseJumpPower=bl.UseJumpPower
if bl.UseJumpPower then
bo.JumpPower=bl.JumpPower
else
bo.JumpHeight=bl.JumpHeight
end

if not(bk.Parent and bp.Parent)then
task.wait(0.2)
continue
end

local bM=bp.Position
local bN=bk.Position
local bO=bN-bM
local bP=Vector3.new(bO.X,0,bO.Z).Magnitude


if inAir()and bO.Magnitude<=aS then
task.wait(0.05)
continue
end



local bQ,bR,bS=false,false,0
if bP>aR and not isSwimming()then
bQ,bR,bS=analyzeObstacle(bN)
if bQ and not bR then
bJ=os.clock()+2
end
end

if bO.Magnitude>aS then
bn:PivotTo(bk.CFrame*CFrame.new(3,0,3))
task.wait(0.2)
elseif bP<=aR and math.abs(bO.Y)<6 then

bo:MoveTo(bM)
task.wait(0.2)
elseif isSwimming()then

bo:MoveTo(bN)
task.wait(0.15)
elseif os.clock()>=bJ then

bo:MoveTo(bN)
if bQ and bR and bS<3.3*bq then
doJump()
end
task.wait(0.1)


if bp.AssemblyLinearVelocity.Magnitude<1 then
bK+=0.1
if bK>0.5 then
doJump()
bK=0
end
else
bK=0
end
else
local bT=pcall(function()
bG:ComputeAsync(bM,bN)
end)

if bT and bG.Status==Enum.PathStatus.Success then
walkWaypoints(bG:GetWaypoints(),bN)
else

bo:MoveTo(bN)
task.wait(0.4)
if bp.AssemblyLinearVelocity.Magnitude<1 then
doJump()
end
end
end
end
end)
end




l.CharacterAdded:Connect(spawnFollower)
l.CharacterRemoving:Connect(cleanup)

if l.Character then
task.spawn(spawnFollower,l.Character)
end



local bi=j.LocalPlayer
local bj={}

_G.Main.Antifling=false

local function setupCharacterCollision(bk)
local function disableCollide(bl)
if _G.Main.Antifling and bl:IsA"BasePart"then
bl.CanCollide=false
end
end

for bl,bm in ipairs(bk:GetChildren())do
disableCollide(bm)
end

local bl=bk.ChildAdded:Connect(disableCollide)

local bm=o.Stepped:Connect(function()
if _G.Main.Antifling and bk:IsDescendantOf(workspace)then
for bm,bn in ipairs(bk:GetChildren())do
if bn:IsA"BasePart"and bn.CanCollide then
bn.CanCollide=false
end
end
end
end)

bk.Destroying:Connect(function()
bl:Disconnect()
bm:Disconnect()
end)
end

local function trackPlayer(bk)
if bk==bi then return end
local bl=bk.CharacterAdded:Connect(setupCharacterCollision)
if bk.Character then
setupCharacterCollision(bk.Character)
end
bj[bk]=bl
end

local function untrackPlayer(bk)
if bj[bk]then
bj[bk]:Disconnect()
bj[bk]=nil
end
end

for bk,bl in ipairs(j:GetPlayers())do
trackPlayer(bl)
end

j.PlayerAdded:Connect(trackPlayer)
j.PlayerRemoving:Connect(untrackPlayer)



local bk

local function StartWalkFling()
function getRoot(bl)
if bl and bl:FindFirstChildOfClass"Humanoid"then
return bl:FindFirstChildOfClass"Humanoid".RootPart
else
return nil
end
end

if bk then return end

bk=task.spawn(function()
local bl=0.1

while true do
o.Heartbeat:Wait()
local bm=l.Character
local bn=getRoot(bm)

while not(bm and bm.Parent and bn and bn.Parent)do
o.Heartbeat:Wait()
bm=l.Character
bn=getRoot(bm)
end

local bo=bn.Velocity
bn.Velocity=bo*10000+Vector3.new(0,-1E4,0)

o.RenderStepped:Wait()
if bm and bm.Parent and bn and bn.Parent then
bn.Velocity=bo
end

o.Stepped:Wait()
if bm and bm.Parent and bn and bn.Parent then
bn.Velocity=bo+Vector3.new(0,bl,0)
bl=bl*-1
end
end
end)
end

local function StopWalkFling()
if bk then
task.cancel(bk)
for bl,bm in ipairs(bi.Character:GetDescendants())do
if bm:IsA"BasePart"then
bm.AssemblyLinearVelocity=Vector3.zero
bm.AssemblyAngularVelocity=Vector3.zero
end
end
bk=nil
end
end



o.Heartbeat:Connect(function()
if u.enabled and bi.Character then
local bl=bi.Character
local bm=bl:WaitForChild"HumanoidRootPart"
if bm then
u.old=true
for bn,bo in pairs(bi.Character:GetChildren())do
if bo:IsA"BasePart"and bo.Name~="HumanoidRootPart"then
bo.LocalTransparencyModifier=0.5
bo.Reflectance=0
end
end
u.loc=bm.CFrame
if bm.AssemblyLinearVelocity.Magnitude<0.01 then
bm.AssemblyLinearVelocity=Vector3.new(0,0.01,0)
end
local bn=u.loc*CFrame.new(math.random(-1E3,1000),math.random(10000,11000),math.random(-1E3,1000))
bm.CFrame=bn
o.RenderStepped:Wait()
bm.CFrame=u.loc
end
end
if not u.enabled and u.old then
for bl,bm in pairs(bi.Character:GetChildren())do
if bm:IsA"BasePart"and bm.Name~="HumanoidRootPart"then
bm.LocalTransparencyModifier=0
end
end
u.old=false
end
end)

local bl
bl=hookmetamethod(game,"__index",newcclosure(function(bm,bn)
if u.enabled and not checkcaller()and bn=="CFrame"and bi.Character and bm==bi.Character.HumanoidRootPart then
return u.loc
end
return bl(bm,bn)
end))



