-- Mascot
do
local assetId = ""
if isfile(mascotPath) then
    local getAsset = getcustomasset or loadcustomasset
    assetId = getAsset(mascotPath)
end

local targetGui = (gethui and gethui()) or CoreGui
local windowFrame = nil

for _, obj in ipairs(targetGui:GetDescendants()) do
    if obj:IsA("TextLabel") and obj.Text:find("femboy.gg") then
        local parent = obj.Parent
        while parent and parent ~= targetGui do
            if (parent:IsA("Frame") or parent:IsA("CanvasGroup")) 
                and parent.AbsoluteSize.X >= 450 
                and parent.AbsoluteSize.X <= 950 then
                windowFrame = parent
            end
            parent = parent.Parent
        end
        if windowFrame then break end
    end
end

if windowFrame and assetId ~= "" then
    windowFrame.ClipsDescendants = false
    
    local edgeImage = Instance.new("ImageButton")
    edgeImage.Name = "CustomEdgeAsset"
    edgeImage.BackgroundTransparency = 1
    edgeImage.AutoButtonColor = false
    edgeImage.Image = assetId
    edgeImage.ScaleType = Enum.ScaleType.Stretch

    local defaultSize = UDim2.fromOffset(230, 380)
    local squishSize = UDim2.fromOffset(250, 320)

    edgeImage.Size = defaultSize
    edgeImage.Position = UDim2.new(0, 10, 0, -30)
    edgeImage.AnchorPoint = Vector2.new(0.5, 0.5)
    edgeImage.ZIndex = 100
    edgeImage.Parent = windowFrame

    -- Звук клика с предзагрузкой для спама
    local sService = game:GetService("SoundService")
    local baseSound = Instance.new("Sound")
    baseSound.Name = "MascotClickSound"
    baseSound.SoundId = "rbxassetid://5852470908"
    baseSound.Volume = 1
    baseSound.Parent = sService

    task.spawn(function()
        pcall(function()
            game:GetService("ContentProvider"):PreloadAsync({ baseSound })
        end)
    end)

    -- Обработка быстрых кликов, звука и сплющивания
    local squishTween = nil

    edgeImage.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sService:PlayLocalSound(baseSound)

            if squishTween then squishTween:Cancel() end
            squishTween = TweenService:Create(
                edgeImage,
                TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = squishSize }
            )
            squishTween:Play()
        end
    end)

    local function restoreSize()
        if squishTween then squishTween:Cancel() end
        squishTween = TweenService:Create(
            edgeImage,
            TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
            { Size = defaultSize }
        )
        squishTween:Play()
    end

    edgeImage.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            restoreSize()
        end
    end)
    edgeImage.MouseLeave:Connect(restoreSize)

    -- Плавное появление и пропадание через Library.Toggled
    local lastState = Library.Toggled
    local activeTween = nil

    edgeImage.Visible = lastState
    edgeImage.ImageTransparency = lastState and 0 or 1

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not edgeImage or not edgeImage.Parent then
            conn:Disconnect()
            return
        end

        local isVisible = Library.Toggled
        if isVisible ~= lastState then
            lastState = isVisible
            if activeTween then activeTween:Cancel() end

            if isVisible then
                edgeImage.Visible = true
                activeTween = TweenService:Create(
                    edgeImage,
                    TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { ImageTransparency = 0 }
                )
                activeTween:Play()
            else
                activeTween = TweenService:Create(
                    edgeImage,
                    TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { ImageTransparency = 1 }
                )
                activeTween:Play()
                activeTween.Completed:Connect(function()
                    if not lastState then
                        edgeImage.Visible = false
                    end
                end)
            end
        end
    end)
end
end
