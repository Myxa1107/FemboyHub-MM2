local function makeSetting(x,y)
local z=x
return function(A)
if A~=nil then
z=A
if y then y()end
end
return z
end
end

local x=Instance.new"Folder"
x.Name="MM2_ESP"
x.Parent=m

for y,z in ipairs(x:GetChildren())do z:Destroy()end


local y={}
local z=false


local function isAlive(A)
if not A or not A.Parent then return false end

if z and y[A.Name]then
local B=y[A.Name]
if B.Dead or B.Killed then
return false
end
end

local B=A.Character
local C=B and B:FindFirstChildOfClass"Humanoid"
return C~=nil and C.Health>0
end


local function hasTool(A,B)
local C=A:FindFirstChild"Backpack"
if C and C:FindFirstChild(B)then return true end
local D=A.Character
if D and D:FindFirstChild(B)then return true end
return false
end


local function findMurderer()
if z then
for A,B in pairs(y)do
if not B.Dead and not B.Killed and B.Role=="Murderer"then
local C=j:FindFirstChild(A)
if C and isAlive(C)then return C end
end
end
end

for A,B in ipairs(j:GetPlayers())do
if isAlive(B)and hasTool(B,"Knife")then
return B
end
end
return nil
end


local function findSheriff()
if z then
for A,B in pairs(y)do
if not B.Dead and not B.Killed and(B.Role=="Sheriff"or B.Role=="Hero")then
local C=j:FindFirstChild(A)
if C and isAlive(C)then return C end
end
end
end

for A,B in ipairs(j:GetPlayers())do
if isAlive(B)and hasTool(B,"Gun")then
return B
end
end
return nil
end


local function updateRoleCache()
if not isAlive(v)then
v=findMurderer()
end


if not isAlive(w)then
w=findSheriff()
elseif z and y[w.Name]then
local A=y[w.Name].Role
if A~="Sheriff"and A~="Hero"and not hasTool(w,"Gun")then
w=findSheriff()
end
end
end


local function GetRole(A)
if not isAlive(A)then
return"Dead"
end

if z and y[A.Name]then
local B=y[A.Name]
if B.Dead or B.Killed then
return"Dead"
end

if B.Role=="Murderer"then
return"Murderer"
elseif B.Role=="Sheriff"then
return"Sheriff"
elseif B.Role=="Hero"then
return"Hero"
elseif B.Role=="Innocent"then

if hasTool(A,"Gun")then
return"Hero"
end
return"Innocent"
end
end


if hasTool(A,"Knife")then return"Murderer"end
if hasTool(A,"Gun")then return"Sheriff"end

return"Dead"
end

local function setupPlayerData()
local A=game.ReplicatedStorage:FindFirstChild"Remotes"
if A then
local B=A:FindFirstChild"Gameplay"
if B then
local C=B:FindFirstChild"PlayerDataChanged"
local D=B:FindFirstChild"GetCurrentPlayerData"
if C and D then
local E=D:InvokeServer()
y=E
z=true
updateRoleCache()

C.OnClientEvent:Connect(function(F)
y=F
z=true

v=nil
w=nil
updateRoleCache()
if UpdatePlayerCheckboxes then UpdatePlayerCheckboxes()end
if RefreshTargetInfo then RefreshTargetInfo()end
end)
return true
end
end
end
return false
end

setupPlayerData()


local function GetColor(A)
if A=="Murderer"then return Color3.fromRGB(255,50,50)end
if A=="Sheriff"then return Color3.fromRGB(50,50,255)end
if A=="Innocent"then return Color3.fromRGB(50,255,50)end
if A=="Hero"then return Color3.fromRGB(255,255,50)end
return Color3.fromRGB(199,199,199)
end

local A={}

function RefreshHighlights()
for B,C in pairs(A)do C:Destroy()end
A={}
if not _G.ESP.EnabledPlayers()then return end

for B,C in ipairs(j:GetPlayers())do
if C==k then continue end
local D=C.Character
if not D then continue end
local E=GetRole(C)

local F=GetColor(E)
local G=Instance.new"Highlight"
G.Name="PlayerHL"
G.FillTransparency=0.5
G.OutlineTransparency=0
G.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
G.FillColor=F
G.OutlineColor=F
G.Adornee=D
G.Parent=x
G.Enabled=true
A[C]=G
end
end


function RefreshNames()
for B,C in ipairs(x:GetChildren())do
if C:IsA"BillboardGui"and C.Name:match"_Name$"then C:Destroy()end
end
if not _G.ESP.EnabledPlayers()then return end

for B,C in ipairs(j:GetPlayers())do
if C==k then continue end
local D=C.Character
if not D or not D:FindFirstChild"Head"then continue end

local E=GetRole(C)
local F=GetColor(E)
local G=Instance.new"BillboardGui"
G.Name=C.Name.."_Name"
G.Size=UDim2.new(0,120,0,24)
G.StudsOffset=Vector3.new(0,2.0,0)
G.AlwaysOnTop=true
G.Adornee=D.Head
G.Parent=x
local H=Instance.new"TextLabel"
H.Size=UDim2.new(1,0,1,0)
H.BackgroundTransparency=1
H.Text=C.DisplayName
H.TextScaled=false
H.TextSize=14
H.Font=Enum.Font.GothamMedium
H.TextColor3=F
H.TextStrokeTransparency=0
H.TextStrokeColor3=Color3.fromRGB(0,0,0)
H.Parent=G
G.Enabled=true
end
end


function RefreshAll()
RefreshHighlights()
RefreshNames()
if UpdatePlayerCheckboxes then UpdatePlayerCheckboxes()end
if RefreshTargetInfo then RefreshTargetInfo()end
end

function SetupPlayerTracking(B)
if not B then return end

local function onChanged()
RefreshAll()
end

B.CharacterAdded:Connect(onChanged)
B.CharacterRemoving:Connect(onChanged)

local function onToolAdded(C)
if C:IsA"Tool"and(C.Name=="Knife"or C.Name=="Gun")then
onChanged()
end
end

if B.Character then
B.Character.ChildAdded:Connect(onToolAdded)
end
B.CharacterAdded:Connect(function(C)
C.ChildAdded:Connect(onToolAdded)
local D=B:FindFirstChild"Backpack"
if D then
D.ChildAdded:Connect(onToolAdded)
else
B.ChildAdded:Connect(function(E)
if E.Name=="Backpack"then
E.ChildAdded:Connect(onToolAdded)
end
end)
end
end)
end

for B,C in ipairs(j:GetPlayers())do
SetupPlayerTracking(C)
end
j.PlayerAdded:Connect(SetupPlayerTracking)

j.PlayerRemoving:Connect(function(B)
if A[B]then A[B]:Destroy()end
end)

_G.ESP.EnabledPlayers=makeSetting(false,RefreshAll)


local B=_G.ESP._refreshAll or RefreshAll

B()

task.spawn(function()
while true do
task.wait(0.5)
RefreshAll()
end
end)



local C=false
local D=true
local E=true
local F=false


local G={window=0.18,accW=0.5,turnW=0.4}




local H=1
local I=0.08
local J=0.725
local K=8


local L=0.1
local M=250
local N=6
local O=1
local P=3.333333333333333E-2
local Q=20
local R=1.2
local S=3
local T=20


local U=150
local V=60


local W={0.12,0.18,0.25}
local X={0,0.5,1}
local Y={0,0.4,0.8}
local Z=10
local _=0.05
local aa=0.005
local ab=300
local ac=1

local ad=true
local ae=0.08
local af=150
local ag=0.97
local ah=0.01
local ai=40
local aj=0.5
local ak=3
local al=2.0
local am=0.95


local an=math.max(table.unpack(W))+0.05

local ao={}
local ap={}

local aq=Instance.new"Folder"
aq.Name="PredictMarkers"
aq.Parent=workspace


local ar={}
for as,at in ipairs(W)do
for au,av in ipairs(X)do
for aw,ax in ipairs(Y)do
table.insert(ar,{wi=as,window=at,accW=av,turnW=ax})
end
end
end

local as={}
local at=0
local au={window=G.window,accW=G.accW,turnW=G.turnW}
local av
local aw=0



local ax=7

local function newModel()
local ay={n=0,wf={},ws={}}
for az=1,ax do
ay.wf[az]=0
ay.ws[az]=0
end
return ay
end

local ay=newModel()

local function getState(az)
local aA=ao[az]
if not aA then
aA={
hist={},queue={},epoch=0,
model=newModel(),
revCount=0,stopCount=0,meanRev=1,wasMoving=false,
}
ao[az]=aA
end
return aA
end


local function getPing()
local az=p.Network.ServerStatsItem:FindFirstChild"Data Ping"
return az and az:GetValue()/1000 or 0
end

local function wrapAngle(az)
return(az+math.pi)%(2*math.pi)-math.pi
end

local function headingOf(az)
return math.atan2(az.X,az.Z)
end


local function buildRayParams()
local az=RaycastParams.new()
az.FilterType=Enum.RaycastFilterType.Exclude
local aA={aq}
for aB,aC in ipairs(j:GetPlayers())do
if aC.Character then
table.insert(aA,aC.Character)
end
end
az.FilterDescendantsInstances=aA
return az
end



local function resetMotion(az)
table.clear(az.hist)
table.clear(az.queue)
az.epoch+=1
az.vel,az.acc,az.turn=nil,nil,nil
az.stableHead,az.lastRev,az.wasMoving=nil,nil,false
az.predPos,az.predDir=nil,nil
end

local function pushSample(az,aA,aB)
local aC=az.hist
local aD=aC[#aC]
if aD and(aB-aD.pos).Magnitude>T then
resetMotion(az)
end
table.insert(aC,{t=aA,pos=aB})
while#aC>2 and aA-aC[1].t>an do
table.remove(aC,1)
end
end



local function estimateMotion(az,aA)
local aB=#az
if aB<4 then return nil end

local aC=az[aB]
local aD=aB
for aE=1,aB do
if aC.t-az[aE].t<=aA then
aD=aE
break
end
end
if aB-aD+1<4 then return nil end

local aE=az[aD]
local aF=aC.t-aE.t
if aF<aA*0.6 then return nil end

local aG=aE.t+aF/2
local aH=aE
for aI=aD+1,aB do
if az[aI].t>=aG then
aH=az[aI]
break
end
end

local aI,aJ=aH.t-aE.t,aC.t-aH.t
if aI<0.03 or aJ<0.03 then return nil end

local aK=(aH.pos-aE.pos)/aI
local aL=(aC.pos-aH.pos)/aJ
local aM=(aI+aJ)/2

local aN=(aL-aK)/aM
if aN.Magnitude>M then
aN=aN.Unit*M
end
local aO=aL+aN*(aJ/2)

local aP=Vector3.new(aK.X,0,aK.Z)
local aQ=Vector3.new(aL.X,0,aL.Z)
local aR=0
if aP.Magnitude>O and aQ.Magnitude>O then
aR=math.clamp(wrapAngle(headingOf(aQ)-headingOf(aP))/aM,-N,N)
end

return aO,aN,aR
end

local function updateMotion(az)
local aA,aB,aC=estimateMotion(az.hist,au.window)
if aA then
az.vel,az.acc,az.turn=aA,aB,aC
end
end







local function groundDisplacement(az,aA,aB,aC,aD,aE,aF)
local aG=Vector3.new(az.X,0,az.Z)
local aH=Vector3.new(aA.X,0,aA.Z)*aC
local aI=aB*aD
local aJ=math.max(aF,aG.Magnitude)
local aK=Vector3.zero
local aL=0
while aL<aE do
local aM=math.min(P,aE-aL)
aL+=aM
if aL<=L then
aG+=aH*aM
end
if aI~=0 and aG.Magnitude>O then
local aN=aI*aM
local aO,aP=math.cos(aN),math.sin(aN)
aG=Vector3.new(aG.X*aO+aG.Z*aP,0,-aG.X*aP+aG.Z*aO)
end
if aG.Magnitude>aJ then
aG=aG.Unit*aJ
end
aK+=aG*aM
end
return aK
end

local function isGroundedNormal(az)
if az.Sit or az.FloorMaterial==Enum.Material.Air then
return false
end
local aA=az:GetState()
return aA~=Enum.HumanoidStateType.Climbing and aA~=Enum.HumanoidStateType.Swimming
end







local function updatePattern(az,aA,aB)
local aC=az.vel
if not aC then return end
local aD=Vector3.new(aC.X,0,aC.Z)
local aE=aD.Magnitude
if aE>=ak then
az.wasMoving=true
az.avgSpeed=az.avgSpeed and(az.avgSpeed+(aE-az.avgSpeed)*(1-math.exp(-0.5*aB)))or aE
local aF=headingOf(aD)
if not az.stableHead then
az.stableHead=aF
elseif math.abs(wrapAngle(aF-az.stableHead))>al then

if az.lastRev then
local aG=aA-az.lastRev
if aG<3 then
az.meanRev+=(math.clamp(aG,0.1,2)-az.meanRev)*0.2
end
end
az.lastRev=aA
az.revCount+=1
az.stableHead=aF
else
az.stableHead+=wrapAngle(aF-az.stableHead)*(1-math.exp(-6*aB))
end
elseif aE<O and az.wasMoving then
az.wasMoving=false
az.stopCount+=1
end
end

local function dotw(az,aA)
local aB=0
for aC=1,ax do
aB+=az[aC]*aA[aC]
end
return aB
end



local function buildFeatures(az,aA,aB)
local aC=az.vel
if not aC then return nil end
local aD=Vector3.new(aC.X,0,aC.Z)
local aE=aD.Magnitude
if aE<O then return nil end

local aF=aD/aE
local aG=Vector3.new(aF.Z,0,-aF.X)
local aH=az.acc or Vector3.zero
local aI=aE/math.max(aA,1)
local aJ=0
if az.revCount>=3 and az.lastRev then
aJ=math.clamp((aB-az.lastRev)/az.meanRev,0,2)-1
end

local aK={
1,
aI,
aH:Dot(aF)/M,
aH:Dot(aG)/M,
(az.turn or 0)/N,
aJ,
aJ*aI,
}
return aK,aF,aG
end



local function learnUpdate(az,aA,aB)
local aC=aA.T
if aC<0.02 then return end
local aD=aA.x

local aE,aF=dotw(az.wf,aD),dotw(az.ws,aD)
local aG=aA.base+(aA.fwd*aE+aA.side*aF)*aC
local aH=math.min((aB-aA.base).Magnitude,Z)
local aI=math.min((aB-aG).Magnitude,Z)

az.n+=1
local aJ=math.max(ah,1/az.n)
local aK,aL=az.eBase or aH,az.eCorr or aI
az.eBase=aK+(aH-aK)*aJ
az.eCorr=aL+(aI-aL)*aJ


local aM=aB-aA.base
local aN=aM:Dot(aA.fwd)/aC-aE
local aO=aM:Dot(aA.side)/aC-aF
local aP=1e-3
for aQ=1,ax do
aP+=aD[aQ]*aD[aQ]
end
for aQ=1,ax do
az.wf[aQ]=math.clamp(az.wf[aQ]+ae*aN*aD[aQ]/aP,-ai,ai)
az.ws[aQ]=math.clamp(az.ws[aQ]+ae*aO*aD[aQ]/aP,-ai,ai)
end
end

local function modelUsable(az)
return az.n>=af and az.eBase~=nil and az.eCorr~=nil and az.eCorr<az.eBase*ag
end


local function learnedCorrection(az,aA,aB,aC)
if not ad or not az.vel or not isGroundedNormal(aA)then return nil end
local aD,aE,aF=buildFeatures(az,aA.WalkSpeed,aB)
if not aD then return nil end

local aG
if modelUsable(az.model)then
aG=az.model
end
if modelUsable(ay)and(not aG or ay.eCorr<aG.eCorr)then
aG=ay
end
if not aG then return nil end

local aH=(aE*dotw(aG.wf,aD)+aF*dotw(aG.ws,aD))*aC
local aI=Vector3.new(az.vel.X,0,az.vel.Z).Magnitude
local aJ=aj*aI*aC
if aH.Magnitude>aJ and aH.Magnitude>0 then
aH=aH.Unit*aJ
end
return aH
end

local function logShadow(az,aA,aB,aC,aD)
if az.nextSample and aC<az.nextSample then return end
az.nextSample=aC+_
if not isGroundedNormal(aA)then return end

local aE={}
for aF,aG in ipairs(W)do
local aH,aI,aJ=estimateMotion(az.hist,aG)
if not aH then return end
aE[aF]={v=aH,a=aI,tr=aJ}
end
local aF=aE[math.ceil(#W/2)].v
if Vector3.new(aF.X,0,aF.Z).Magnitude<O then return end

local aG=aA.WalkSpeed
local aH=table.create(#ar)
for aI,aJ in ipairs(ar)do
local aK=aE[aJ.wi]
aH[aI]=groundDisplacement(aK.v,aK.a,aK.tr,aJ.accW,aJ.turnW,aD,aG)
end


local aI
if ad and az.vel then
local aJ,aK,aL=buildFeatures(az,aG,aC)
if aJ then
local aM=groundDisplacement(az.vel,az.acc or Vector3.zero,az.turn or 0,
au.accW,au.turnW,aD,aG)
aI={x=aJ,fwd=aK,side=aL,base=aM,T=aD}
end
end

table.insert(az.queue,{
due=aC+aD,
start=aB.Position,
preds=aH,
learn=aI,
epoch=az.epoch,
})
end

local function scoreQueue(az,aA,aB,aC)
local aD=az.queue
while aD[1]and aC>=aD[1].due do
local aE=table.remove(aD,1)

if aE.epoch==az.epoch and isGroundedNormal(aA)then
local aF=aB.Position
local aG=Vector3.new(aF.X-aE.start.X,0,aF.Z-aE.start.Z)
at+=1
local aH=math.max(aa,1/at)
for aI,aJ in ipairs(aE.preds)do
local aK=math.min((aG-aJ).Magnitude,Z)
local aL=as[aI]or aK
as[aI]=aL+(aK-aL)*aH
end
if aE.learn then
learnUpdate(az.model,aE.learn,aG)
learnUpdate(ay,aE.learn,aG)
end
end
end
end

local function selectBest(az)
if not E then return end
if az-aw<ac or at<ab then return end
aw=az

local aA,aB=math.huge
for aC=1,#ar do
local aD=as[aC]
if aD and aD<aA then
aB,aA=aC,aD
end
end
if not aB then return end
if av and as[av]and aA>=as[av]*am then
return
end

av=aB
local aC=ar[aB]
au={window=aC.window,accW=aC.accW,turnW=aC.turnW}
if F then
print(string.format("[Predict] window=%.2f acc=%.1f turn=%.1f  ошибка=%.2f studs (замеров: %d)",
aC.window,aC.accW,aC.turnW,aA,at))
end
end


_G.GetPredictStats=function()
return au,av and as[av]or nil,at
end




local function simulate(az,aA,aB,aC,aD)
local aE=aB.Position
local aF=az.vel or Vector3.zero
local aG=Vector3.new(aF.X,0,aF.Z)
local aH=aF.Y
local aI=az.acc or Vector3.zero
local aJ=Vector3.new(aI.X,0,aI.Z)*au.accW
local aK=(az.turn or 0)*au.turnW
local aL=workspace.Gravity
local aM=aA.FloorMaterial~=Enum.Material.Air


local aN=aA:GetState()
if aA.Sit or aN==Enum.HumanoidStateType.Climbing or aN==Enum.HumanoidStateType.Swimming then
return aE+aF*aC,aG
end


if aM then
local aO=workspace:Raycast(aE,Vector3.new(0,-20,0),aD)
if aO then
az.offset=aE.Y-aO.Position.Y
end
end
local aO=az.offset or(aA.HipHeight+1)


if aM and aH>Q then
aM=false
elseif aM then
aH=0
end

local aP=math.max(aA.WalkSpeed,aG.Magnitude)

local aQ=0
while aQ<aC do
local aR=math.min(P,aC-aQ)
aQ+=aR


if aM then
if aQ<=L then
aG+=aJ*aR
end
if aK~=0 and aG.Magnitude>O then
local aS=aK*aR
local aT,aU=math.cos(aS),math.sin(aS)
aG=Vector3.new(aG.X*aT+aG.Z*aU,0,-aG.X*aU+aG.Z*aT)
end
if aG.Magnitude>aP then
aG=aG.Unit*aP
end
end


local aS=aG*aR
local aT=aS.Magnitude
if aT>1e-4 then
local aU=aS/aT
local aV=workspace:Raycast(aE,aU*(aT+R),aD)
if aV and math.abs(aV.Normal.Y)<0.7 then
local aW=math.max(0,aV.Distance-R)
aE+=aU*math.min(aT,aW)
local aX=Vector3.new(aV.Normal.X,0,aV.Normal.Z)
if aX.Magnitude>1e-3 then
aX=aX.Unit
local aY=aG:Dot(aX)
if aY<0 then
aG-=aX*aY
end
end
else
aE+=aS
end
end


if aM then
local aU=workspace:Raycast(aE,Vector3.new(0,-(aO+S),0),aD)
if aU then
aE=Vector3.new(aE.X,aU.Position.Y+aO,aE.Z)
aH=0
else
aM=false
aH=0
end
else
aH-=aL*aR
local aU=aH*aR
if aH<=0 then
local aV=workspace:Raycast(aE,Vector3.new(0,-(-aU+aO+0.1),0),aD)
if aV then
aE=Vector3.new(aE.X,aV.Position.Y+aO,aE.Z)
aH=0
aM=true
else
aE+=Vector3.new(0,aU,0)
end
else
local aV=workspace:Raycast(aE,Vector3.new(0,aU+1.5,0),aD)
if aV then
aH=0
else
aE+=Vector3.new(0,aU,0)
end
end
end
end

return aE,aG
end



local function createMarker(az)
local aA=Instance.new"Part"
