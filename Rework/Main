	13735114082,
}


local BODY_BUNDLE_ID = 282


local KEEP_DEFAULT_HEAD = true

local HEAD_ID = 0
local TORSO_ID = 0
local LEFT_ARM_ID = 0
local RIGHT_ARM_ID = 0
local LEFT_LEG_ID = 0
local RIGHT_LEG_ID = 0


local ANIMATION_BUNDLE_ID = 0

local ANIMATION_PACK = {
    Idle     = 742637544,
    Walk     = 742640026,
    Run      = 742638842,
    Jump     = 742637942,
    Fall     = 742637151,
