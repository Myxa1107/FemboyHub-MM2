local function getFPS()
local bO=p.FrameRateManager.RenderAverage:GetValue()
if bO>0 then
return math.floor(1000/bO)
end
return 0
end

local function getPing()

local bO=p.Network.ServerStatsItem["Data Ping"]:GetValue()
return math.floor(bO)
end

