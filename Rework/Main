local ANIMATION_LOAD_TIMEOUT = 2 -- сколько секунд ждать загрузку анимации

--------------------------------------------------------------------
-- БАНДЛЫ
--------------------------------------------------------------------
local bundleCache = {}

-- Возвращает HumanoidDescription из бандла (или nil, если не вышло)
local function getBundleDescription(bundleId)
	if bundleCache[bundleId] ~= nil then
		return bundleCache[bundleId] or nil
	end

	local result = false

	local ok, details = pcall(function()
		return AssetService:GetBundleDetailsAsync(bundleId)
	end)

	if ok and details and details.Items then
		for _, item in ipairs(details.Items) do
			if item.Type == "UserOutfit" then
				local ok2, bundleDesc = pcall(function()
					return Players:GetHumanoidDescriptionFromOutfitId(item.Id)
				end)
				if ok2 and bundleDesc then
					result = bundleDesc
					break
				end
			end
		end
	else
	end

	bundleCache[bundleId] = result
	return result or nil
end

local BODY_PROPS = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }

-- итоговые айди анимаций (считаются один раз)
local resolvedAnimations

local function resolveAnimations()
	if resolvedAnimations then
		return resolvedAnimations
	end

	local result = {}
	for name, id in pairs(ANIMATION_PACK) do
		result[name] = id
	end

	if ANIMATION_BUNDLE_ID > 0 then
		local bundleDesc = getBundleDescription(ANIMATION_BUNDLE_ID)
		if bundleDesc then
			for name in pairs(ANIMATION_PACK) do
				-- у HumanoidDescription нет некоторых свойств (например SwimIdle) - pcall
				local ok, value = pcall(function()
					return bundleDesc[name .. "Animation"]
				end)
				if ok and type(value) == "number" and value > 0 then
					result[name] = value
				end
			end
		end
	end

	resolvedAnimations = result
	return result
end

--------------------------------------------------------------------
-- СОЗДАНИЕ ЧЕЛОВЕЧКА
--------------------------------------------------------------------
local function buildDescription()
	local desc = Instance.new("HumanoidDescription")

	desc.Shirt = SHIRT_ID
	desc.Pants = PANTS_ID
	desc.GraphicTShirt = GRAPHIC_TSHIRT_ID
	desc.Face = FACE_ID

	if SKIN_COLOR then
		desc.HeadColor = SKIN_COLOR
		desc.TorsoColor = SKIN_COLOR
		desc.LeftArmColor = SKIN_COLOR
		desc.RightArmColor = SKIN_COLOR
		desc.LeftLegColor = SKIN_COLOR
		desc.RightLegColor = SKIN_COLOR
	end

	-- тело
	local bodyFromBundle = false
	if BODY_BUNDLE_ID > 0 then
		local bundleDesc = getBundleDescription(BODY_BUNDLE_ID)
		if bundleDesc then
			bodyFromBundle = true
			for _, prop in ipairs(BODY_PROPS) do
				desc[prop] = bundleDesc[prop]
			end
			if KEEP_DEFAULT_HEAD then
				desc.Head = 0
			elseif HEAD_ID > 0 then
				desc.Head = HEAD_ID
			end
			-- лицо из бандла, если своё не указано
			-- (не берём при стандартной голове - динамическое лицо на ней не работает)
			if FACE_ID == 0 and not KEEP_DEFAULT_HEAD and bundleDesc.Face > 0 then
				desc.Face = bundleDesc.Face
			end
		end
	end

	if not bodyFromBundle then
		if HEAD_ID > 0 then desc.Head = HEAD_ID end
		if TORSO_ID > 0 then desc.Torso = TORSO_ID end
		if LEFT_ARM_ID > 0 then desc.LeftArm = LEFT_ARM_ID end
		if RIGHT_ARM_ID > 0 then desc.RightArm = RIGHT_ARM_ID end
		if LEFT_LEG_ID > 0 then desc.LeftLeg = LEFT_LEG_ID end
		if RIGHT_LEG_ID > 0 then desc.RightLeg = RIGHT_LEG_ID end
	end

	-- аксессуары
	if #ACCESSORY_IDS > 0 then
		local list = {}
		for _, id in ipairs(ACCESSORY_IDS) do
			table.insert(list, tostring(id))
		end
		desc.HatAccessory = table.concat(list, ",")
	end

	return desc
end

--------------------------------------------------------------------
-- ЗАГРУЗКА АНИМАЦИЙ
--------------------------------------------------------------------
-- Грузит трек из готового Animation-объекта и ждёт, пока он реально загрузится.
-- Если не загрузился за таймаут - возвращает nil.
local function finishTrack(animator, anim, looped, priority)
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then
		return nil
	end

	local waited = 0
	while track.Length == 0 and waited < ANIMATION_LOAD_TIMEOUT do
		waited += task.wait(0.1)
	end
	if track.Length == 0 then
		track:Destroy()
		return nil
	end

	track.Looped = looped
	track.Priority = priority
	return track
end

-- Способ 1: обычная загрузка по rbxassetid
local function loadTrackDirect(animator, id, looped, priority)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	return finishTrack(animator, anim, looped, priority)
end

-- Способ 2: скачиваем сам AnimationClip и регистрируем его локально
local function loadTrackViaClip(animator, id, looped, priority)
	local ok, clip = pcall(function()
		return AnimationClipProvider:GetAnimationClipAsync("rbxassetid://" .. tostring(id))
	end)
	if not ok or not clip then
		return nil
	end

	local ok2, contentId = pcall(function()
		return AnimationClipProvider:RegisterAnimationClip(clip)
	end)
	if not ok2 or not contentId then
		return nil
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = contentId
	return finishTrack(animator, anim, looped, priority)
end

local function loadTrack(animator, id, looped, priority)
	if not id or id == 0 then
		return nil
	end

	local track = loadTrackDirect(animator, id, looped, priority)
	if track then
		return track
	end

	track = loadTrackViaClip(animator, id, looped, priority)
	if track then
		return track
	end

	return nil
end

--------------------------------------------------------------------
-- ЧЕЛОВЕЧЕК
--------------------------------------------------------------------
local follower
local connections = {}
local runToken = 0 -- меняется при каждом новом человечке / удалении, останавливает старые циклы

local function applyVisibility()
	if not follower then
		return
	end
	local mod = FOLLOWER_VISIBLE and 0 or 1
	for _, d in ipairs(follower:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = mod
		end
	end
end

-- Показать / скрыть человечка (можно вызывать из этого же скрипта в любой момент)
local function setFollowerVisible(visible)
	FOLLOWER_VISIBLE = visible and true or false
	applyVisibility()
end

local function cleanup()
	runToken += 1
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	if follower then
		follower:Destroy()
	end
	follower = nil
end

local function spawnFollower(character)
	cleanup()
	local myToken = runToken

	local root = character:WaitForChild("HumanoidRootPart")
	local humanoid = character:WaitForChild("Humanoid")

	local animations = resolveAnimations()

	local model = Players:CreateHumanoidModelFromDescription(buildDescription(), Enum.HumanoidRigType.R15)
	model.Name = "Follower_" .. player.Name

	local fHumanoid = model:WaitForChild("Humanoid")
	local fRoot = model:WaitForChild("HumanoidRootPart")
	fHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	-- пока грузилась модель, мог начаться респавн
	if runToken ~= myToken then
		model:Destroy()
		return
	end

	model:PivotTo(root.CFrame * CFrame.new(3, 0, 3))
	model.Parent = workspace
	follower = model

	-- размер = размер игрока * 0.75
	local scale = character:GetScale() * SCALE_MULTIPLIER
	model:ScaleTo(scale)

	-- видимость
	applyVisibility()
	table.insert(connections, model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = FOLLOWER_VISIBLE and 0 or 1
		end
	end))

	-- без коллизии с игроком: NoCollisionConstraint между всеми частями
	-- человечка и всеми частями персонажа игрока
	local function noCollide(a, b)
		local c = Instance.new("NoCollisionConstraint")
		c.Part0 = a
		c.Part1 = b
		c.Parent = a
	end

	for _, fp in ipairs(model:GetDescendants()) do
		if fp:IsA("BasePart") then
			for _, cp in ipairs(character:GetDescendants()) do
				if cp:IsA("BasePart") then
					noCollide(fp, cp)
				end
			end
		end
	end

	-- новые части (аксессуары, инструменты) тоже не должны сталкиваться
	table.insert(connections, character.DescendantAdded:Connect(function(cp)
		if cp:IsA("BasePart") then
			for _, fp in ipairs(model:GetDescendants()) do
				if fp:IsA("BasePart") then
					noCollide(fp, cp)
				end
			end
		end
	end))

	table.insert(connections, model.DescendantAdded:Connect(function(fp)
		if fp:IsA("BasePart") then
			for _, cp in ipairs(character:GetDescendants()) do
				if cp:IsA("BasePart") then
					noCollide(fp, cp)
				end
			end
		end
	end))

	----------------------------------------------------------------
	-- АНИМАЦИИ
	----------------------------------------------------------------
	local animator = fHumanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = fHumanoid
	end

	local idle, walk, run, jump, fall, climb, swim, swimIdle
	local current

	local function play(track)
		if current == track then
			return
		end
		if current then
			current:Stop(0.15)
		end
		current = track
		if track then
			track:Play(0.15)
		end
	end

	local function updateLocomotion(speed)
		local state = fHumanoid:GetState()
		if state == Enum.HumanoidStateType.Freefall
			or state == Enum.HumanoidStateType.Climbing
			or state == Enum.HumanoidStateType.Swimming then
			return
		end
		if speed > 0.5 then
			if speed > 18 and run then
				play(run)
			else
				play(walk or run)
			end
		else
			play(idle)
		end
	end

	-- грузим анимации параллельно, чтобы человечек сразу мог ходить
	local P = Enum.AnimationPriority
	local specs = {
		{ "Idle",     true,  P.Idle,   function(t) idle = t end },
		{ "Walk",     true,  P.Core,   function(t) walk = t end },
		{ "Run",      true,  P.Core,   function(t) run = t end },
		{ "Jump",     false, P.Action, function(t) jump = t end },
		{ "Fall",     true,  P.Action, function(t) fall = t end },
		{ "Climb",    true,  P.Action, function(t) climb = t end },
		{ "Swim",     true,  P.Action, function(t) swim = t end },
		{ "SwimIdle", true,  P.Action, function(t) swimIdle = t end },
	}

	for _, spec in ipairs(specs) do
		task.spawn(function()
			local name, looped, priority, setter = spec[1], spec[2], spec[3], spec[4]

			local track = loadTrack(animator, animations[name], looped, priority)
			if not track then
				if animations[name] and animations[name] > 0 then
				end
				track = loadTrack(animator, DEFAULT_ANIMATIONS[name], looped, priority)
			end

			if runToken ~= myToken then
				return
			end

			setter(track)

			local v = fRoot.AssemblyLinearVelocity
			updateLocomotion(Vector3.new(v.X, 0, v.Z).Magnitude)
		end)
	end

	table.insert(connections, fHumanoid.Running:Connect(updateLocomotion))

	table.insert(connections, fHumanoid.Climbing:Connect(function(speed)
		if climb then
			play(climb)
			climb:AdjustSpeed(speed / 5)
		end
	end))

	table.insert(connections, fHumanoid.Swimming:Connect(function(speed)
		if speed > 1 and swim then
			play(swim)
		else
			play(swimIdle or swim)
		end
	end))

	local S = Enum.HumanoidStateType
	local jumpStarted = 0

	local function currentSpeed()
		local v = fRoot.AssemblyLinearVelocity
		return Vector3.new(v.X, 0, v.Z).Magnitude
	end

	table.insert(connections, fHumanoid.StateChanged:Connect(function(_, new)
		if new == S.Jumping then
			jumpStarted = os.clock()
			play(jump or fall)
		elseif new == S.Freefall then
			-- даём анимации прыжка проиграть начало, потом включаем падение
			local delayTime = 0
			if jump and current == jump then
				delayTime = math.max(0, 0.3 - (os.clock() - jumpStarted))
			end
			if delayTime > 0 then
				task.delay(delayTime, function()
					if runToken == myToken and fHumanoid:GetState() == S.Freefall then
						play(fall)
					end
				end)
			else
				play(fall)
			end
		elseif new == S.Climbing then
			play(climb)
		elseif new == S.Swimming then
			play(swimIdle or swim)
		elseif new == S.Landed or new == S.Running or new == S.RunningNoPhysics then
			-- приземлились - сразу выключаем прыжок/падение
			updateLocomotion(currentSpeed())
		end
	end))

	----------------------------------------------------------------
	-- СЛЕДОВАНИЕ (PathfindingService)
	----------------------------------------------------------------
	task.spawn(function()
		local function alive()
			return runToken == myToken and model.Parent ~= nil
		end

		local pathParams = {
			AgentRadius = 2 * scale,
			AgentHeight = 5 * scale,
			AgentCanJump = true,
			AgentCanClimb = true, -- лестницы (TrussPart)
			WaypointSpacing = math.max(2, 4 * scale),
			Costs = { Water = 20 }, -- вода проходима (плывём)
		}

		local path
		local okPath = pcall(function()
			path = PathfindingService:CreatePath(pathParams)
		end)
		if not okPath or not path then
			pathParams.AgentCanClimb = nil
			path = PathfindingService:CreatePath(pathParams)
		end

		local function isSwimming()
			return fHumanoid:GetState() == Enum.HumanoidStateType.Swimming
		end

		-- проверка препятствия перед человечком (на уровне груди и у самых ног)
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = { model, character }
		rayParams.RespectCanCollide = true

		-- луч вперёд; игроков и других персонажей за препятствие не считаем
		local function castAhead(origin, dir)
			local hit = workspace:Raycast(origin, dir, rayParams)
			if hit then
				local m = hit.Instance:FindFirstAncestorOfClass("Model")
				if not (m and m:FindFirstChildOfClass("Humanoid")) then
					return hit
				end
			end
			return nil
		end

		local function maxJumpHeight()
			if fHumanoid.UseJumpPower then
				return fHumanoid.JumpPower ^ 2 / (2 * workspace.Gravity)
			end
			return fHumanoid.JumpHeight
		end

		-- возвращает: есть ли препятствие, можно ли его перепрыгнуть, расстояние до него
		local function analyzeObstacle(goal)
			local myPos = fRoot.Position
			local flatDir = Vector3.new(goal.X - myPos.X, 0, goal.Z - myPos.Z)
			if flatDir.Magnitude < 0.1 then
				return false, false, 0
			end
			local dir = flatDir.Unit * (3.5 * scale)

			-- низкие лучи: на уровне корпуса и у самых ног
			local nearest
			for _, yOff in ipairs({ 0, -2.2 * scale }) do
				local hit = castAhead(myPos + Vector3.new(0, yOff, 0), dir)
				if hit and (not nearest or hit.Distance < nearest.Distance) then
					nearest = hit
				end
			end
			if not nearest then
				return false, false, 0
			end

			-- высокий луч на высоте почти максимального прыжка:
			-- если он ничего не задел - препятствие можно перепрыгнуть
			local groundY = myPos.Y - (fHumanoid.HipHeight + fRoot.Size.Y / 2)
			local topY = groundY + maxJumpHeight() * 0.85
			local highHit = castAhead(Vector3.new(myPos.X, topY, myPos.Z), dir)

			return true, highHit == nil, nearest.Distance
		end

		local usePathUntil = 0 -- до какого момента идём по пути (после встречи препятствия)
		local stuckTime = 0

		local JUMP_TRIGGER_DISTANCE = 3 -- за сколько студов (* масштаб) до точки прыжка прыгаем

		local function inAir()
			local s = fHumanoid:GetState()
			return s == Enum.HumanoidStateType.Freefall or s == Enum.HumanoidStateType.Jumping
		end

		-- прыжок только с земли (в воздухе и воде не прыгаем)
		local function doJump()
			if not inAir() and not isSwimming() then
				fHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end

		-- ждём приземления, чтобы не перестраивать путь в воздухе
		local function waitForLanding()
			local t = 0
			while alive() and inAir() and t < 3 do
				task.wait(0.05)
				t += 0.05
			end
		end

		-- идём по точкам пути; возвращаемся, если игрок ушёл далеко или застряли
		local function walkWaypoints(waypoints, goal)
			for i = 2, #waypoints do
				if not alive() then
					return
				end

				local wp = waypoints[i]
				local needJump = wp.Action == Enum.PathWaypointAction.Jump
				fHumanoid:MoveTo(wp.Position)

				local reached = false
				local conn = fHumanoid.MoveToFinished:Connect(function()
					reached = true
				end)

				local t = 0
				local jumped = false
				while alive() and not reached and t < 2 do
					task.wait(0.05)
					t += 0.05

					-- прыгаем, когда подошли к точке с прыжком
					if needJump and not jumped then
						local d = fRoot.Position - wp.Position
						if Vector3.new(d.X, 0, d.Z).Magnitude < JUMP_TRIGGER_DISTANCE * scale then
							jumped = true
							doJump()
						end
					end

					-- в воздухе путь не перестраиваем
					if (root.Position - goal).Magnitude > REPATH_DISTANCE and not inAir() then
						break
					end
					if isSwimming() then
						break
					end
				end
				conn:Disconnect()

				-- если дошли до точки, а прыгнуть не успели - прыгаем сейчас
				if needJump and not jumped then
					jumped = true
					doJump()
				end

				-- после прыжка продолжаем идти вперёд, к следующей точке, и ждём приземления
				if jumped then
					local nextWp = waypoints[i + 1]
					if nextWp then
						fHumanoid:MoveTo(nextWp.Position)
					end
					task.wait(0.05)
					waitForLanding()
				end

				if not alive() then
					return
				end
				if (root.Position - goal).Magnitude > REPATH_DISTANCE then
					return
				end
				if isSwimming() or (not reached and not jumped) then
					return -- перестроим путь
				end
			end
		end

		while alive() do
			-- повторяем параметры игрока
			fHumanoid.WalkSpeed = humanoid.WalkSpeed
			fHumanoid.UseJumpPower = humanoid.UseJumpPower
			if humanoid.UseJumpPower then
				fHumanoid.JumpPower = humanoid.JumpPower
			else
				fHumanoid.JumpHeight = humanoid.JumpHeight
			end

			if not (root.Parent and fRoot.Parent) then
				task.wait(0.2)
				continue
			end

			local myPos = fRoot.Position
			local goal = root.Position
			local offset = goal - myPos
			local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude

			-- в воздухе ничего не пересчитываем: сохраняем направление прыжка
			if inAir() and offset.Magnitude <= TELEPORT_DISTANCE then
				task.wait(0.05)
				continue
			end

			-- препятствие впереди: низкое - перепрыгиваем, высокое - обходим
			-- (поиск пути включается минимум на 2 секунды)
			local blocked, jumpable, obstacleDist = false, false, 0
			if flat > FOLLOW_DISTANCE and not isSwimming() then
				blocked, jumpable, obstacleDist = analyzeObstacle(goal)
				if blocked and not jumpable then
					usePathUntil = os.clock() + 2
				end
			end

			if offset.Magnitude > TELEPORT_DISTANCE then
				model:PivotTo(root.CFrame * CFrame.new(3, 0, 3))
				task.wait(0.2)
			elseif flat <= FOLLOW_DISTANCE and math.abs(offset.Y) < 6 then
				-- мы рядом - стоим
				fHumanoid:MoveTo(myPos)
				task.wait(0.2)
			elseif isSwimming() then
				-- в воде просто плывём к игроку
				fHumanoid:MoveTo(goal)
				task.wait(0.15)
			elseif os.clock() >= usePathUntil then
				-- идём к игроку напрямую; перед невысоким препятствием прыгаем
				fHumanoid:MoveTo(goal)
				if blocked and jumpable and obstacleDist < 3.3 * scale then
					doJump()
				end
				task.wait(0.1)

				-- упёрлись в невысокую ступеньку - прыгаем
				if fRoot.AssemblyLinearVelocity.Magnitude < 1 then
					stuckTime += 0.1
					if stuckTime > 0.5 then
						doJump()
						stuckTime = 0
					end
				else
					stuckTime = 0
				end
			else
				local ok = pcall(function()
					path:ComputeAsync(myPos, goal)
				end)

				if ok and path.Status == Enum.PathStatus.Success then
					walkWaypoints(path:GetWaypoints(), goal)
				else
					-- путь не построился (например игрок в воздухе) - идём напрямую и прыгаем, если застряли
					fHumanoid:MoveTo(goal)
					task.wait(0.4)
					if fRoot.AssemblyLinearVelocity.Magnitude < 1 then
						doJump()
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------
-- ЗАПУСК / РЕСПАВН
--------------------------------------------------------------------
player.CharacterAdded:Connect(spawnFollower)
player.CharacterRemoving:Connect(cleanup)

if player.Character then
	task.spawn(spawnFollower, player.Character)
end
end
-- Antifling

local localPlayer = Players.LocalPlayer
local connections = {}

_G.Main.Antifling = false

local function setupCharacterCollision(character)
	local function disableCollide(part)
		if _G.Main.Antifling and part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	for _, part in ipairs(character:GetChildren()) do
		disableCollide(part)
	end

	local childAddedConn = character.ChildAdded:Connect(disableCollide)

	local steppedConn = RunService.Stepped:Connect(function()
		if _G.Main.Antifling and character:IsDescendantOf(workspace) then
			for _, part in ipairs(character:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end)

	character.Destroying:Connect(function()
		childAddedConn:Disconnect()
		steppedConn:Disconnect()
	end)
end

local function trackPlayer(player)
	if player == localPlayer then return end
	local charAddedConn = player.CharacterAdded:Connect(setupCharacterCollision)
	if player.Character then
		setupCharacterCollision(player.Character)
	end
	connections[player] = charAddedConn
end

local function untrackPlayer(player)
	if connections[player] then
		connections[player]:Disconnect()
		connections[player] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end

Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(untrackPlayer)

-- WalkFling

local flingThread = nil

local function StartWalkFling()
	function getRoot(char)
		if char and char:FindFirstChildOfClass("Humanoid") then
			return char:FindFirstChildOfClass("Humanoid").RootPart
		else
			return nil
		end
	end

	if flingThread then return end -- Если поток уже запущен, ничего не делаем

	flingThread = task.spawn(function()
		local movel = 0.1

		while true do
			RunService.Heartbeat:Wait()
			local character = player.Character
			local root = getRoot(character)

			while not (character and character.Parent and root and root.Parent) do
				RunService.Heartbeat:Wait()
				character = player.Character
				root = getRoot(character)
			end

			local vel = root.Velocity
			root.Velocity = vel * 10000 + Vector3.new(0, -10000, 0)

			RunService.RenderStepped:Wait()
			if character and character.Parent and root and root.Parent then
				root.Velocity = vel
			end

			RunService.Stepped:Wait()
			if character and character.Parent and root and root.Parent then
				root.Velocity = vel + Vector3.new(0, movel, 0)
				movel = movel * -1
			end
		end
	end)
end

local function StopWalkFling()
	if flingThread then
		task.cancel(flingThread) -- Мгновенно убивает поток
		for _, part in ipairs(localPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
		flingThread = nil
	end
end

-- Desync -- Invis
do
RunService.Heartbeat:Connect(function()
    if invisT.enabled and localPlayer.Character then
        local character = localPlayer.Character
        local root = character:WaitForChild("HumanoidRootPart")
        if root then
			invisT.old = true
			for _,v in pairs(localPlayer.Character:GetChildren()) do
				if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
					v.LocalTransparencyModifier = 0.5
					v.Reflectance = 0
				end
			end
            invisT.loc = root.CFrame
			if root.AssemblyLinearVelocity.Magnitude < 0.01 then
				root.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
			end
            local newCframe = invisT.loc * CFrame.new(math.random(-1000,1000),math.random(10000,11000),math.random(-1000,1000))
            root.CFrame = newCframe
            RunService.RenderStepped:Wait()
            root.CFrame = invisT.loc
        end
    end
	if not invisT.enabled and invisT.old then
		for _,v in pairs(localPlayer.Character:GetChildren()) do
			if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
				v.LocalTransparencyModifier = 0
			end
		end
		invisT.old = false
	end
end)

local desynchook = nil
desynchook = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if invisT.enabled and not checkcaller() and key == "CFrame" and localPlayer.Character and self == localPlayer.Character.HumanoidRootPart then
        return invisT.loc -- Возвращаем сохраненную позицию
    end
    return desynchook(self, key)
end))
end
