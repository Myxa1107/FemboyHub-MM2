local function resetAllCustomEffects()
cJ.Size=0
cJ.Enabled=false
cG.Enabled=false

co.Enabled=false
co.FarIntensity=0
co.NearIntensity=0

cn.Enabled=false
cn.Size=0

ck.Enabled=false
cp.Enabled=false
cq.Enabled=false
end


local cL
local function toggleShadersState(cM)
cv=cM

for cN,cO in pairs(b3:GetDescendants())do
if cO:IsA"BasePart"then
cO.Reflectance=cv and cw.reflect or 0
end
end

if cv then
for cN,cO in ipairs(ci)do
if cO.instance and cO.instance.Parent then
if not cO.instance:IsA"Atmosphere"and not cO.instance:IsA"Sky"and not cO.instance:IsA"Clouds"then
cO.instance.Enabled=false
end
end
end

cc(b5,"Technology",cx.tech)

if cL then cL:Disconnect()end
cL=b7.PreRender:Connect(function()
if not cv then return end


if cx.mblur then
cJ.Enabled=true
local cN=(b4.CFrame.LookVector-cK).Magnitude
cJ.Size=math.clamp(math.abs(cN)*11*5/2,0,cx.mblurMax)
cK=b4.CFrame.LookVector
else
cJ.Size=0
cJ.Enabled=false
end


cG.Enabled=cx.sflare
if cx.sflare then
local cN=b4:WorldToScreenPoint(b4.CFrame.Position+b5:GetSunDirection())
local cO,cP=Vector2.new(cN.X,cN.Y),cN.Z>0
local cQ=b3:FindPartOnRay(Ray.new(b4.CFrame.Position,b5:GetSunDirection()*900),b9.Character)
local cR=(cQ==nil)and 1 or 0
cI=cI*0.5+cR*0.5
local cS=b4.ViewportSize/2
local cT=cO-cS
for cU,cV in ipairs(cF)do
cV.ImageTransparency=1-cI+cE[cU]*cI
local cW,cX=cV.AbsoluteSize,cS+cT*cC[cU]
cV.Position=UDim2.new(0.004,cX.X-cW.X/2,0.004,cX.Y-cW.Y/2)
cV.Visible=cP
end
local cU=cH.AbsoluteSize
cH.Position=UDim2.new(0.004,cO.X-cU.X/2,0.004,cO.Y-cU.Y/2)
cH.Visible=cP
end


if cu then
cl.SkyboxBk,cl.SkyboxDn,cl.SkyboxFt=cz.bk,cz.dn,cz.ft
cl.SkyboxLf,cl.SkyboxRt,cl.SkyboxUp=cz.lt,cz.rt,cz.up


cp.Enabled=cx.cor
if cx.cor then
cp.Brightness=cu.fhnchvhfjsd
cp.Contrast=cu.ugtbbjhygt
cp.Saturation=cu.tfbghuugbnjhg
cp.TintColor=cx.customTintColor and cx.tintColor or cu.fvrtccvghghj
end


cn.Enabled=cx.blr
cn.Size=cx.blr and cu.njnfg or 0


ck.Enabled=cx.bl
if cx.bl then
ck.Intensity=cu.jnfdhbnfcvh
ck.Size=cu.fvtyghj
ck.Threshold=cu.ygbhnj
end


co.Enabled=cx.dof
if cx.dof then
co.FarIntensity=cu.jdfkd
co.FocusDistance=cu.fvgsdfg
co.InFocusRadius=cu.sdkvkflv
co.NearIntensity=cu.hbjhd
else
co.FarIntensity=0
co.NearIntensity=0
end


cq.Enabled=cx.rays
if cx.rays then
cq.Intensity=cu.sr_int or 0.15
cq.Spread=cu.sr_spr or 0.5
end


b5.Ambient=cu.yfbghj
b5.ClockTime=cu.tgvbyd
b5.GeographicLatitude=cu.ghuybhuyhj
b5.Brightness=cu.khnbfth
b5.ColorShift_Bottom=cu.hgyghkg
b5.ColorShift_Top=cu.yfbhjku
b5.EnvironmentDiffuseScale=cu.ygyyfgvhbjytrt
b5.EnvironmentSpecularScale=cu.sdfcddc
b5.GlobalShadows=cu.hgnujuu7thgr
b5.OutdoorAmbient=cu.hyhnngtf
b5.ExposureCompensation=cu.hdfr7thgr
b5.FogEnd=math.huge
b5.FogStart=math.huge


b6.WaterWaveSpeed=cw.waterSpeed
b6.WaterWaveSize=cw.waterSize
b6.WaterTransparency=cw.waterTrans


cr.Cover=cu.gyhgtg
cr.Density=cu.ygbhggv
cr.Color=cu.jghbjhgyfd


cm.Density=cu.shdbsnjfc
cm.Offset=cu.skdjfkdm
cm.Color=cx.customAtmosColor and cx.atmosColor or cu.sjdjncdjf
cm.Decay=cu.efjdjfk
cm.Glare=cu.sejfd
cm.Haze=cu.jddfjsd
end
end)
else
if cL then
cL:Disconnect()
cL=nil
end

resetAllCustomEffects()
cc(b5,"Technology",ch)

cl.SkyboxBk,cl.SkyboxDn,cl.SkyboxFt=cy.bk,cy.dn,cy.ft
cl.SkyboxLf,cl.SkyboxRt,cl.SkyboxUp=cy.lt,cy.rt,cy.up

for cN,cO in pairs(cs.lighting)do b5[cN]=cO end
for cN,cO in pairs(cs.terrain)do b6[cN]=cO end

cm.Density=ct.shdbsnjfc
cm.Offset=ct.skdjfkdm
cm.Color=ct.sjdjncdjf
cm.Decay=ct.efjdjfk
cm.Glare=ct.sejfd
cm.Haze=ct.jddfjsd

cr.Cover=ct.gyhgtg
cr.Density=ct.ygbhggv
cr.Color=ct.jghbjhgyfd

for cN,cO in ipairs(ci)do
if cO.instance and cO.instance.Parent then
for cP,cQ in pairs(cO.props)do
cO.instance[cP]=cQ
end
end
end
end
end




