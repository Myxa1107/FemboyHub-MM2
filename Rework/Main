-- Mobile

local MobileGroupBox = Tabs.Main:AddGroupbox({
    Side = "Right",
    Name = "Mobile",
	IconName = "smartphone"
})

local EMobileButtons = {
	Shoot = {"Shoot", function(self)
		shootMurderer()
	end},
	Invisibility = {"Invis", function(self)
		invisT.enabled = not invisT.enabled
		InvisToggle:SetValue(invisT.enabled)
	end},
	KillAll = {"Kill All", function(self)
		if not localPlayer.Backpack:FindFirstChild("Knife") and not localPlayer.Character:FindFirstChild("Knife") then return end
		if localPlayer.Backpack:FindFirstChild("Knife") then localPlayer.Character:FindFirstChild("Humanoid"):EquipTool(localPlayer.Backpack:FindFirstChild("Knife")) end
		localPlayer.Character.Knife.Events.KnifeStabbed:FireServer()
		for _,v in Players:GetChildren() do
			if v.Character then
				localPlayer.Character.Knife.Events.HandleTouched:FireServer(v.Character.PrimaryPart)
			end
		end
	end},
}

