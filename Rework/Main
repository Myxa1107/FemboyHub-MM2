})

local KillAllButton = MurdererGroupBox:AddButton({
    Text = "Kill All",
    Icon = "swords",
    Func = function()
		for _,v in Players:GetChildren() do
			game.ReplicatedStorage.Remotes.Gameplay.EliminatePlayer:InvokeServer(v)
		end
    end
})

local ESPGroupBox = Tabs.Visuals:AddGroupbox({
    Side = "Left", -- case-insensitive
    Name = "ESP",
    Description = "Names, chams and etc.",
    IconName = "scan-eye",
})

local ESPToggle = ESPGroupBox:AddToggle("Esp Enabled", {
	Text = "ESP Enabled",
	Default = false,
})

ESPToggle:OnChanged(function(state)
	_G.ESP.EnabledPlayers(state)
end)

task.delay(0.1, function()
	SaveManager:LoadAutoloadConfig()
end)
