TargetInfoGroupBox:AddDropdown("TrollSelectDropdown", {
    Values = { "Shoot", "Bang" },
    Default = "Shoot",
    Multi = false,
    Text = "Troll Mode",
	Callback = function(value)
		CurrentTroll = value
	end
})

