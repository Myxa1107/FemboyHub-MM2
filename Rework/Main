bi.Character.Knife.Events.KnifeStabbed:FireServer()
for cO,cP in j:GetChildren()do
if cP.Character then
bi.Character.Knife.Events.HandleTouched:FireServer(cP.Character.PrimaryPart)
end
end
end},
}

