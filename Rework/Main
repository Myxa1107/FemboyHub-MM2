    Text = "Fling",
    Icon = "skull",
    Func = function()
		flingPlayer(SelectedTarget)
    end
}):AddButton({
    Text = "Troll",
    Icon = "face-grinning",
    Func = function()
		if CurrentTroll == "Shoot" then
			shootMurderer(SelectedTarget)
		elseif CurrentTroll == "Bang" then
			Library:Notify("Under Development!", 2)
		end
    end
})

