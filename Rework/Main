aA.CanQuery=false
aA.CanTouch=false
aA.CastShadow=false
aA.Transparency=0.6
aA.Color=Color3.fromRGB(255,80,80)
aA.Material=Enum.Material.Neon
aA.Parent=aq
return aA
end

local function removeMarker(az)
local aA=ap[az]
if aA then
aA:Destroy()
ap[az]=nil
end
end

local function removeAll(az)
removeMarker(az)
ao[az]=nil
end




