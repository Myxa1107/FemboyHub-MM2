local SHIRT_ID = 139118942165678
local PANTS_ID = 16369992173
local GRAPHIC_TSHIRT_ID = 0
local FACE_ID = 0

-- Цвет кожи. nil = стандартный. Пример: Color3.fromRGB(255, 204, 153)
local SKIN_COLOR = Color3.fromRGB(255, 255, 255)

-- Все аксессуары (шляпы, волосы, рюкзаки и т.д.) просто добавляй в список:
local ACCESSORY_IDS = {
