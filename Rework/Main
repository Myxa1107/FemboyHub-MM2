-- Pshade Shaders LOL
do
-- ==========================================
-- PSHADE ULTIMATE MODULE FOR OBSIDIAN UI
-- Requires:
--   ExtraVisualsTab (Tab / TabBox section for the main Shaders toggle)
--   ShadersTab (Tab / TabBox section for all shader settings)
-- ==========================================

local game = game
local ws = game:GetService("Workspace")
local cam = ws.CurrentCamera
local lg = game:GetService("Lighting")
local terr = ws:FindFirstChildOfClass("Terrain")
local rs = game:GetService("RunService")
local plrs = game:GetService("Players")
local lp = plrs.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local fenv = getfenv()
local shp = fenv.sethiddenproperty or fenv.sethiddenprop or fenv.set_hidden_property or function() end
local ghp = fenv.gethiddenproperty or fenv.gethiddenprop or function() return "ShadowMap" end
local httpget = function(url) return loadstring(game:HttpGet(url))() end

local randomstring = 'https://raw.githubusercontent.com/randomstring0/pshade-ultimate/refs/heads/main/'
local randomsky = randomstring .. 'sky/'
local technology = ghp(lg, 'Technology') or 'ShadowMap'

-- Effect tracking and original state backup
local originalEffects = {}
local customEffects = {}

local function setupEffect(className, parent)
    local existing = parent:FindFirstChildOfClass(className)
    if existing then
        local savedProps = {}
        if className ~= "Sky" and className ~= "Atmosphere" and className ~= "Clouds" then
            savedProps.Enabled = existing.Enabled
            if className == "BlurEffect" then
                savedProps.Size = existing.Size
            elseif className == "DepthOfFieldEffect" then
                savedProps.FarIntensity = existing.FarIntensity
                savedProps.NearIntensity = existing.NearIntensity
                savedProps.FocusDistance = existing.FocusDistance
                savedProps.InFocusRadius = existing.InFocusRadius
            end
        end
        table.insert(originalEffects, { instance = existing, props = savedProps })

        local cloned = existing:Clone()
        cloned.Parent = parent
        if className ~= "Sky" and className ~= "Atmosphere" and className ~= "Clouds" then
            cloned.Enabled = false
        end
        table.insert(customEffects, cloned)
        return cloned
    else
        local created = Instance.new(className, parent)
        if className ~= "Sky" and className ~= "Atmosphere" and className ~= "Clouds" then
            created.Enabled = false
        end
        table.insert(customEffects, created)
        return created
    end
end

local bloom = setupEffect("BloomEffect", lg)
local sky = setupEffect("Sky", lg)
local atmosphere = setupEffect("Atmosphere", lg)
local blur = setupEffect("BlurEffect", lg)
local depth = setupEffect("DepthOfFieldEffect", lg)
local colorcor = setupEffect("ColorCorrectionEffect", lg)
local sray = setupEffect("SunRaysEffect", lg)
local cloud = setupEffect("Clouds", terr)

-- Backup original game lighting and terrain
local backup = {
    lighting = {
        ClockTime = lg.ClockTime, Ambient = lg.Ambient, Brightness = lg.Brightness,
        ColorShift_Bottom = lg.ColorShift_Bottom, ColorShift_Top = lg.ColorShift_Top,
        EnvironmentDiffuseScale = lg.EnvironmentDiffuseScale, EnvironmentSpecularScale = lg.EnvironmentSpecularScale,
        GlobalShadows = lg.GlobalShadows, OutdoorAmbient = lg.OutdoorAmbient,
        GeographicLatitude = lg.GeographicLatitude, ExposureCompensation = lg.ExposureCompensation,
        FogEnd = lg.FogEnd, FogColor = lg.FogColor, FogStart = lg.FogStart
    },
    terrain = {
        WaterReflectance = terr.WaterReflectance, WaterTransparency = terr.WaterTransparency,
        WaterWaveSize = terr.WaterWaveSize, WaterWaveSpeed = terr.WaterWaveSpeed
    }
}

-- Default shader values
local default = {
    yfbghj = lg.Ambient, tgvbyd = lg.ClockTime, ghuybhuyhj = lg.GeographicLatitude,
    khnbfth = lg.Brightness, hgyghkg = lg.ColorShift_Bottom, yfbhjku = lg.ColorShift_Top,
    ygyyfgvhbjytrt = lg.EnvironmentDiffuseScale, sdfcddc = lg.EnvironmentSpecularScale,
    hgnujuu7thgr = lg.GlobalShadows, hyhnngtf = lg.OutdoorAmbient, hdfr7thgr = lg.ExposureCompensation,
    fhnchvhfjsd = colorcor.Brightness, ugtbbjhygt = colorcor.Contrast,
    tfbghuugbnjhg = colorcor.Saturation, fvrtccvghghj = colorcor.TintColor,
    jnfdhbnfcvh = bloom.Intensity, fvtyghj = bloom.Size, ygbhnj = bloom.Threshold,
    njnfg = blur.Size, jdfkd = depth.FarIntensity, fvgsdfg = depth.FocusDistance,
    sdkvkflv = depth.InFocusRadius, hbjhd = depth.NearIntensity,
    gyhgtg = cloud.Cover, ygbhggv = cloud.Density, jghbjhgyfd = cloud.Color,
    shdbsnjfc = atmosphere.Density, skdjfkdm = atmosphere.Offset, sjdjncdjf = atmosphere.Color,
    efjdjfk = atmosphere.Decay, sejfd = atmosphere.Glare, jddfjsd = atmosphere.Haze,
    sr_int = sray.Intensity, sr_spr = sray.Spread
}

local light = table.clone(default)
local wshade = false
local adjust = {
    reflect = 0,
    waterSpeed = terr.WaterWaveSpeed,
    waterSize = terr.WaterWaveSize,
    waterTrans = terr.WaterTransparency
}

local wl = {
    dof = false,
    cor = true,
    bl = true,
    blr = false,
    rays = false,
    sflare = false,
    mblur = false,
    tech = "ShadowMap",
    customAtmosColor = false,
    atmosColor = Color3.fromRGB(199, 210, 255),
    customTintColor = false,
    tintColor = Color3.fromRGB(255, 255, 255),
    mblurMax = 26
}

local defsky = {
    bk = sky.SkyboxBk, dn = sky.SkyboxDn, ft = sky.SkyboxFt,
    lt = sky.SkyboxLf, rt = sky.SkyboxRt, up = sky.SkyboxUp
}
local cussky = {
    bk = 'rbxassetid://9544505500', dn = 'rbxassetid://9544547905', ft = 'rbxassetid://9544504852',
    lt = 'rbxassetid://9544547694', rt = 'rbxassetid://9544547542', up = 'rbxassetid://9544547398'
}

-- Load presets asynchronously
local shadersData = {}
local skyboxData = { default = cussky, game = defsky }

task.spawn(function()
    local presetList = {
        "morning", "midday", "afternoon", "night", "midnight",
        "morning1", "midday1", "afternoon1", "evening1", "night1", "midnight1",
        "black", "green", "red", "yellow", "pink", "gray", "white", "purple",
        "black1", "green1", "red1", "yellow1", "pink1", "gray1", "white1", "purple1",
        "rain", "snow", "fog", "sunny", "cloudy", "storm",
        "autumn", "spring", "summer", "winter"
    }
    for _, name in ipairs(presetList) do
        pcall(function()
            shadersData[name] = httpget(randomstring .. 'shr/' .. name .. '.json')
        end)
    end
    pcall(function() shadersData["evening"] = httpget(randomstring .. 'shr/evening%2Cjson') end)

    local skies = { morning = 'm', midday = 'n', afternoon = 'a', evening = 'e', rain = 'r', cloudy = 'c' }
    for k, v in pairs(skies) do
        pcall(function() skyboxData[k] = httpget(randomsky .. v .. '.json') end)
    end
end)

-- SunFlare & MotionBlur setup
local fdist, fsize, ftrans = {1.7, 0.3, -0.3, -0.9}, {0.7, 0.2, 1.2, 0.45}, {0.8, 0.7, 0.9, 0.6}
local fls, sre, sflare, rmod = {}, Instance.new('ScreenGui', pg), Instance.new('ImageLabel'), 1
sre.Name = 'PShadeFlare'
sre.Enabled = false
sre.ResetOnSpawn = false
sflare.Parent = sre
sflare.SizeConstraint = 'RelativeYY'
sflare.BackgroundTransparency = 1
sflare.Image = 'rbxassetid://277033149'
sflare.ImageColor3 = Color3.new(1, 1, 0.95)
sflare.Size = UDim2.new(3, 0, 3, 0)

for i = 1, #fdist do
    local f = Instance.new('ImageLabel', sre)
    f.Size = UDim2.new(fsize[i] * 0.2, 0, fsize[i] * 0.2, 0)
    f.SizeConstraint = 'RelativeYY'
    f.BackgroundTransparency = 1
    f.ImageTransparency = ftrans[i]
    f.Rotation = -25
    f.Image = 'rbxassetid://15164863822'
    f.ImageColor3 = Color3.new(1, 1, 0.8)
    fls[#fls + 1] = f
end

local mblur = Instance.new("BlurEffect", cam)
mblur.Size = 0
mblur.Enabled = false
local lor = cam.CFrame.LookVector

-- Cleanly reset all custom post-processing effects
local function resetAllCustomEffects()
    mblur.Size = 0
    mblur.Enabled = false
    sre.Enabled = false

    depth.Enabled = false
    depth.FarIntensity = 0
    depth.NearIntensity = 0

    blur.Enabled = false
    blur.Size = 0

    bloom.Enabled = false
    colorcor.Enabled = false
    sray.Enabled = false
end

-- Main shader toggle handler
local renderConn
local function toggleShadersState(state)
    wshade = state

    for _, v in pairs(ws:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Reflectance = wshade and adjust.reflect or 0
        end
    end

    if wshade then
        for _, item in ipairs(originalEffects) do
            if item.instance and item.instance.Parent then
                if not item.instance:IsA("Atmosphere") and not item.instance:IsA("Sky") and not item.instance:IsA("Clouds") then
                    item.instance.Enabled = false
                end
            end
        end

        shp(lg, "Technology", wl.tech)

        if renderConn then renderConn:Disconnect() end
        renderConn = rs.PreRender:Connect(function()
            if not wshade then return end

            -- Motion Blur
            if wl.mblur then
                mblur.Enabled = true
                local mag = (cam.CFrame.LookVector - lor).Magnitude
                mblur.Size = math.clamp(math.abs(mag) * 11 * 5 / 2, 0, wl.mblurMax)
                lor = cam.CFrame.LookVector
            else
                mblur.Size = 0
                mblur.Enabled = false
            end

            -- Sun Flare
            sre.Enabled = wl.sflare
            if wl.sflare then
                local camscreen = cam:WorldToScreenPoint(cam.CFrame.Position + lg:GetSunDirection())
                local sunpos, front = Vector2.new(camscreen.X, camscreen.Y), camscreen.Z > 0
                local ray = ws:FindPartOnRay(Ray.new(cam.CFrame.Position, lg:GetSunDirection() * 900), lp.Character)
                local tar = (ray == nil) and 1 or 0
                rmod = rmod * 0.5 + tar * 0.5
                local scen = cam.ViewportSize / 2
                local vec = sunpos - scen
                for i, v in ipairs(fls) do
                    v.ImageTransparency = 1 - rmod + ftrans[i] * rmod
                    local size, pos = v.AbsoluteSize, scen + vec * fdist[i]
                    v.Position = UDim2.new(0.004, pos.X - size.X / 2, 0.004, pos.Y - size.Y / 2)
                    v.Visible = front
                end
                local zsize = sflare.AbsoluteSize
                sflare.Position = UDim2.new(0.004, sunpos.X - zsize.X / 2, 0.004, sunpos.Y - zsize.Y / 2)
                sflare.Visible = front
            end

            -- Apply Lighting & Effects
            if light then
                sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = cussky.bk, cussky.dn, cussky.ft
                sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = cussky.lt, cussky.rt, cussky.up

                -- ColorCorrection
                colorcor.Enabled = wl.cor
                if wl.cor then
                    colorcor.Brightness = light.fhnchvhfjsd
                    colorcor.Contrast = light.ugtbbjhygt
                    colorcor.Saturation = light.tfbghuugbnjhg
                    colorcor.TintColor = wl.customTintColor and wl.tintColor or light.fvrtccvghghj
                end

                -- Static Blur
                blur.Enabled = wl.blr
                blur.Size = wl.blr and light.njnfg or 0

                -- Bloom
                bloom.Enabled = wl.bl
                if wl.bl then
                    bloom.Intensity = light.jnfdhbnfcvh
                    bloom.Size = light.fvtyghj
                    bloom.Threshold = light.ygbhnj
                end

                -- Depth of Field
                depth.Enabled = wl.dof
                if wl.dof then
                    depth.FarIntensity = light.jdfkd
                    depth.FocusDistance = light.fvgsdfg
                    depth.InFocusRadius = light.sdkvkflv
                    depth.NearIntensity = light.hbjhd
                else
                    depth.FarIntensity = 0
                    depth.NearIntensity = 0
                end

                -- SunRays
                sray.Enabled = wl.rays
                if wl.rays then
                    sray.Intensity = light.sr_int or 0.15
                    sray.Spread = light.sr_spr or 0.5
                end

                -- Lighting
                lg.Ambient = light.yfbghj
                lg.ClockTime = light.tgvbyd
                lg.GeographicLatitude = light.ghuybhuyhj
                lg.Brightness = light.khnbfth
                lg.ColorShift_Bottom = light.hgyghkg
                lg.ColorShift_Top = light.yfbhjku
                lg.EnvironmentDiffuseScale = light.ygyyfgvhbjytrt
                lg.EnvironmentSpecularScale = light.sdfcddc
                lg.GlobalShadows = light.hgnujuu7thgr
                lg.OutdoorAmbient = light.hyhnngtf
                lg.ExposureCompensation = light.hdfr7thgr
                lg.FogEnd = math.huge
                lg.FogStart = math.huge

                -- Terrain Water
                terr.WaterWaveSpeed = adjust.waterSpeed
                terr.WaterWaveSize = adjust.waterSize
                terr.WaterTransparency = adjust.waterTrans

                -- Clouds
                cloud.Cover = light.gyhgtg
                cloud.Density = light.ygbhggv
                cloud.Color = light.jghbjhgyfd

                -- Atmosphere
                atmosphere.Density = light.shdbsnjfc
                atmosphere.Offset = light.skdjfkdm
                atmosphere.Color = wl.customAtmosColor and wl.atmosColor or light.sjdjncdjf
                atmosphere.Decay = light.efjdjfk
                atmosphere.Glare = light.sejfd
                atmosphere.Haze = light.jddfjsd
            end
        end)
    else
        if renderConn then
            renderConn:Disconnect()
            renderConn = nil
        end

        resetAllCustomEffects()
        shp(lg, "Technology", technology)

        sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = defsky.bk, defsky.dn, defsky.ft
        sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = defsky.lt, defsky.rt, defsky.up

        for k, v in pairs(backup.lighting) do lg[k] = v end
        for k, v in pairs(backup.terrain) do terr[k] = v end

        atmosphere.Density = default.shdbsnjfc
        atmosphere.Offset = default.skdjfkdm
        atmosphere.Color = default.sjdjncdjf
        atmosphere.Decay = default.efjdjfk
        atmosphere.Glare = default.sejfd
        atmosphere.Haze = default.jddfjsd

        cloud.Cover = default.gyhgtg
        cloud.Density = default.ygbhggv
        cloud.Color = default.jghbjhgyfd

        for _, item in ipairs(originalEffects) do
            if item.instance and item.instance.Parent then
                for propName, propVal in pairs(item.props) do
                    item.instance[propName] = propVal
                end
            end
        end
    end
end

