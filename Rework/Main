local function buildDirections(aI)
local aJ={}
local aK=math.pi*(3-math.sqrt(5))
for aL=0,aI-1 do
local aM=1-(aL/math.max(aI-1,1))*2
local aN=math.sqrt(1-aM*aM)
local aO=aK*aL
table.insert(aJ,Vector3.new(math.cos(aO)*aN,aM,math.sin(aO)*aN))
end
return aJ
end
aH=buildDirections(aB)

local function getAllCharacters()
local aI={}
for aJ,aK in ipairs(j:GetPlayers())do
if aK.Character then
table.insert(aI,aK.Character)
end
end
return aI
end

local function buildParams(aI)
local aJ=RaycastParams.new()
aJ.FilterType=Enum.RaycastFilterType.Exclude
aJ.FilterDescendantsInstances=aI
return aJ
end


local function hasLineOfSight(aI,aJ,aK)
return n:Raycast(aI,aJ-aI,aK)==nil
end


local function findGround(aI,aJ)
local aK=aI+Vector3.new(0,aG,0)
local aL=n:Raycast(aK,Vector3.new(0,-(aG+20),0),aJ)
if not aL then return nil end
return aL.Position+Vector3.new(0,aE,0)
end


local function getCandidate(aI,aJ,aK,aL)
local aM=n:Raycast(aI,aJ*aK,aL)
if not aM then
return aI+aJ*aK
end
local aN=(aM.Position-aI).Magnitude-aF
if aN<aC then
return nil
end
return aI+aJ*aN
end





function getAvailableSpace(aI:Vector3,aJ:number,aK:{Instance}?):Vector3
local aL=buildParams(aK or getAllCharacters())

local aM=aJ
while aM>=aC do
for aN,aO in ipairs(aH)do
local aP=getCandidate(aI,aO,aM,aL)
if aP then
local aQ=findGround(aP,aL)
if aQ
and(aQ-aI).Magnitude>=aC
and hasLineOfSight(aI,aQ,aL)then
return aQ
end
end
end
aM-=aD
end


return aI
end


function getAvailableSpaceFor(aI:Player,aJ:number):Vector3?
local aK=aI.Character
local aL=aK and aK:FindFirstChild"HumanoidRootPart"
if not aL then return nil end
return getAvailableSpace(aL.Position,aJ,{aK})
end



